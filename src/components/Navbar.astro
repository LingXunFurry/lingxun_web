---
const links = [
    { href: '/', label: '首页' },
    { href: '/gallery/', label: '旅途留影' },
    { href: '/posts/', label: '最近手记' },
    { href: '/friends/', label: '同行者' },
];
const fallbackSocials = [
    { name: 'QQ', icon: 'QQ', link: 'https://qm.qq.com/q/v6P80LZUdM', number: '1651388504' },
    { name: 'QQ 群', icon: 'QQ', link: 'https://qm.qq.com/q/hrqvQDmSjK', number: '1105367000' },
    { name: 'X (Twitter)', icon: 'X', link: 'https://x.com/furrylingx' },
    { name: 'BiliBili', icon: 'B', link: 'https://space.bilibili.com/362846640' },
    { name: '抖音', icon: 'D', link: 'https://v.douyin.com/LsGqWRTDUKc/' },
    { name: '小红书', icon: 'R', link: 'https://www.xiaohongshu.com/user/profile/69c665ea0000000034019dd1' },
];
const socialIconPath = (icon: string) => {
    if (icon === 'QQ') return '/icons/social/qq.png';
    if (icon === 'B') return '/icons/social/bilibili.png';
    if (icon === 'D') return '/icons/social/douyin.png';
    if (icon === 'R') return '/icons/social/xiaohongshu.png';
    return '/icons/social/x.png';
};
const currentPath = Astro.url.pathname;
---

<nav id="navbar" class:list={['site-nav', currentPath === '/' ? 'is-hero-top' : 'is-page-nav']} aria-label="主导航">
    <div class="site-nav__inner">
        <a href="/" class="site-brand">
            <img src="/logo.png" alt="" />
            <span>
                凌巽的酒馆
                <span class="site-brand__en">LINGXUN'S TAVERN</span>
            </span>
        </a>

        <div class="site-nav__links">
            {links.map((link) => (
                <a href={link.href} class="site-nav__link" aria-current={currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'page' : undefined}>
                    {link.label}
                </a>
            ))}
            <div class="site-nav__contact-wrap">
                <button id="contact-menu-btn" class="site-nav__contact-button site-nav__link" type="button" aria-expanded="false" aria-controls="contact-menu">联系凌巽 <span aria-hidden="true">⌄</span></button>
                <div id="contact-menu" class="site-nav__contact-menu" aria-hidden="true" data-public-pending aria-busy="true" inert>
                    <span class="site-nav__contact-note">点开名片，将在新标签页打开外部页面</span>
                    {fallbackSocials.map((social) => (
                        <a href={social.link} target="_blank" rel="noopener noreferrer" title={`打开${social.name}外部页面`}>
                            <img src={socialIconPath(social.icon)} alt="" loading="lazy" />
                            <span>{social.name}</span>
                            <span aria-hidden="true">↗</span>
                        </a>
                    ))}
                </div>
            </div>
            <button id="theme-toggle" class="site-nav__theme-button" type="button" aria-label="切换昼夜主题" aria-pressed="false"><span aria-hidden="true">◐</span><span class="theme-toggle__label">昼夜</span></button>
        </div>

        <button id="mobile-menu-btn" class="site-nav__menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="打开导航菜单">
            <span aria-hidden="true">☰</span>
        </button>
    </div>

    <div id="mobile-menu" class="site-nav__mobile" aria-hidden="true" inert>
        {links.map((link) => (
            <a href={link.href} class="site-nav__link" aria-current={currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'page' : undefined}>
                {link.label}
            </a>
        ))}
        <div class="site-nav__mobile-group">
            <button id="mobile-contact-btn" class="site-nav__link site-nav__mobile-parent" type="button" aria-expanded="false" aria-controls="mobile-contact-menu">联系凌巽 <span aria-hidden="true">⌄</span></button>
            <div id="mobile-contact-menu" class="site-nav__mobile-submenu" aria-hidden="true" data-public-pending aria-busy="true" inert>
                <span class="site-nav__contact-note">点开名片，将在新标签页打开外部页面</span>
                {fallbackSocials.map((social) => (
                    <a href={social.link} target="_blank" rel="noopener noreferrer" title={`打开${social.name}外部页面`}>
                        <img src={socialIconPath(social.icon)} alt="" loading="lazy" />
                        <span>{social.name}</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                ))}
            </div>
        </div>
        <button id="mobile-theme-toggle" class="site-nav__link site-nav__mobile-theme" type="button"><span aria-hidden="true">◐</span> 昼夜主题</button>
    </div>
</nav>

<script>
    import { fetchRequired as fetchPublic, getApiBase, initPublicContent, type SocialLink } from '../lib/publicContent';
    import { loadSiteContent, siteText, siteFormat } from '../lib/siteContent';
    const initNavbar = () => {
        const navbar = document.getElementById('navbar');
        const menuButton = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
        const mobileMenu = document.getElementById('mobile-menu');
        const scrollRoot = document.getElementById('fullpage-container');
        const contactButton = document.getElementById('contact-menu-btn');
        const contactMenu = document.getElementById('contact-menu');
        const mobileContactButton = document.getElementById('mobile-contact-btn');
        const mobileContactMenu = document.getElementById('mobile-contact-menu');
        const themeButtons = [document.getElementById('theme-toggle'), document.getElementById('mobile-theme-toggle')].filter(Boolean) as HTMLElement[];

        const syncNav = () => {
            const scrollTop = Math.max(window.scrollY, scrollRoot?.scrollTop || 0);
            navbar?.classList.toggle('is-scrolled', scrollTop > 24);
            navbar?.classList.toggle('is-hero-top', Boolean(document.querySelector('.hero-section')) && scrollTop <= 24);
            navbar?.classList.toggle('is-page-nav', Boolean(document.querySelector('.gallery-page, .friends-page, .archive-page, .dynamic-post-page, .article-page')));
        };

        const closeMenu = () => {
            mobileMenu?.classList.remove('is-open');
            mobileMenu?.setAttribute('aria-hidden', 'true');
            mobileMenu?.setAttribute('inert', '');
            menuButton?.setAttribute('aria-expanded', 'false');
            menuButton?.setAttribute('aria-label', siteText('navbar.menu_open', '打开导航菜单'));
            navbar?.classList.remove('is-open');
            closeContactMenu();
        };

        const closeContactMenu = () => {
            navbar?.classList.remove('is-contact-open');
            [contactMenu, mobileContactMenu].forEach((menu) => {
                menu?.classList.remove('is-open');
                menu?.setAttribute('aria-hidden', 'true');
                menu?.setAttribute('inert', '');
            });
            [contactButton, mobileContactButton].forEach((button) => button?.setAttribute('aria-expanded', 'false'));
        };

        const toggleContactMenu = (button: HTMLElement | null, menu: HTMLElement | null) => {
            const isOpen = menu?.classList.toggle('is-open') ?? false;
            menu?.setAttribute('aria-hidden', String(!isOpen));
            menu?.toggleAttribute('inert', !isOpen);
            button?.setAttribute('aria-expanded', String(isOpen));
            navbar?.classList.toggle('is-contact-open', Boolean(contactMenu?.classList.contains('is-open') || mobileContactMenu?.classList.contains('is-open')));
        };

        const syncTheme = () => {
            const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
            themeButtons.forEach((button) => {
                button.setAttribute('aria-pressed', String(theme === 'light'));
                const label = button.querySelector('.theme-toggle__label');
                if (label) label.textContent = theme === 'light' ? siteText('navbar.to_dark', '夜间') : siteText('navbar.to_light', '白天');
            });
        };
        const syncContactTitles = () => {
            [contactMenu, mobileContactMenu].forEach(menu => menu?.querySelectorAll('a').forEach(link => {
                link.title = siteFormat('navbar.external_title', '打开{name}外部页面', { name: link.querySelector('span')?.textContent || '' });
            }));
        };
        loadSiteContent().then(() => {
            syncTheme();
            menuButton?.setAttribute('aria-label', mobileMenu?.classList.contains('is-open')
                ? siteText('navbar.menu_close', '关闭导航菜单') : siteText('navbar.menu_open', '打开导航菜单'));
            document.getElementById('theme-toggle')?.setAttribute('aria-label', siteText('navbar.theme', '昼夜主题'));
            syncContactTitles();
        });

        const toggleTheme = () => {
            const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
            document.documentElement.dataset.theme = next;
            localStorage.setItem('lingxun-theme', next);
            syncTheme();
        };

        const renderContacts = async () => {
            try {
                const apiBase = getApiBase().replace(/\/$/, '');
                const socials = await fetchPublic<SocialLink[]>('/api/public/socials');
                if (!Array.isArray(socials)) return;
                const html = socials.map((social: { link: string; name: string; icon?: string }) => {
                    const icon = getSocialIconUrl(social.icon, social.name, apiBase);
                    return `<a href="${escapeHtml(social.link)}" target="_blank" rel="noopener noreferrer" title="打开${escapeHtml(social.name)}外部页面">${icon ? `<img src="${escapeHtml(icon)}" alt="" loading="lazy" />` : ''}<span>${escapeHtml(social.name)}</span><span aria-hidden="true">↗</span></a>`;
                }).join('');
                [contactMenu, mobileContactMenu].forEach((menu) => {
                    if (menu) menu.innerHTML = `<span class="site-nav__contact-note">点开名片，将在新标签页打开外部页面</span>${html || '<span class="site-nav__contact-empty">暂无联系方式</span>'}`;
                });
                syncContactTitles();
            } catch {
                [contactMenu, mobileContactMenu].forEach(menu => {
                    if (menu) menu.innerHTML = '<span class="site-nav__contact-empty">暂时没能加载联系方式，请刷新重试</span>';
                });
            }
        };

        menuButton?.addEventListener('click', () => {
            const isOpen = mobileMenu?.classList.toggle('is-open') ?? false;
            mobileMenu?.setAttribute('aria-hidden', String(!isOpen));
            mobileMenu?.toggleAttribute('inert', !isOpen);
            menuButton.setAttribute('aria-expanded', String(isOpen));
            menuButton.setAttribute('aria-label', isOpen ? siteText('navbar.menu_close', '关闭导航菜单') : siteText('navbar.menu_open', '打开导航菜单'));
            navbar?.classList.toggle('is-open', isOpen);
        });

        contactButton?.addEventListener('click', () => toggleContactMenu(contactButton, contactMenu));
        mobileContactButton?.addEventListener('click', () => toggleContactMenu(mobileContactButton, mobileContactMenu));
        themeButtons.forEach((button) => button.addEventListener('click', toggleTheme));
        document.addEventListener('click', (event) => {
            if (!(event.target as HTMLElement).closest('.site-nav__contact-wrap, .site-nav__mobile-group')) closeContactMenu();
        });
        navbar?.addEventListener('keydown', (event) => {
            if (event.key !== 'Escape') return;
            const activeContact = contactMenu?.classList.contains('is-open') ? contactButton
                : mobileContactMenu?.classList.contains('is-open') ? mobileContactButton : null;
            if (activeContact) {
                event.preventDefault();
                closeContactMenu();
                activeContact.focus();
            } else if (mobileMenu?.classList.contains('is-open')) {
                event.preventDefault();
                closeMenu();
                menuButton?.focus();
            }
        });

        mobileMenu?.addEventListener('click', event => {
            if (event.target instanceof Element && event.target.closest('a')) closeMenu();
        });
        window.addEventListener('scroll', syncNav, { passive: true });
        scrollRoot?.addEventListener('scroll', syncNav, { passive: true });
        syncNav();
        syncTheme();
        initPublicContent('#contact-menu, #mobile-contact-menu', renderContacts);
    };

    function escapeHtml(value: string) {
        return String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
    }
    function getSocialIcon(icon: string | undefined, name: string) {
        const key = `${icon ?? ''} ${name}`.toLowerCase();
        if (key.includes('qq')) return 'qq';
        if (key.includes('bilibili') || key.includes('b站') || key.trim() === 'b') return 'bilibili';
        if (key.includes('douyin') || key.includes('抖音') || key.trim() === 'd') return 'douyin';
        if (key.includes('xiaohongshu') || key.includes('小红书') || key.trim() === 'r') return 'xiaohongshu';
        if (key.includes('x')) return 'x';
        return 'x';
    }
    function getSocialIconUrl(icon: string | undefined, name: string, apiBase: string) {
        const value = String(icon || '').trim();
        if (!value) return '';
        const preset = { QQ: 'qq', X: 'x', B: 'bilibili', D: 'douyin', R: 'xiaohongshu' }[value];
        if (preset) return `/icons/social/${preset}.png`;
        if (/^https?:\/\//i.test(value)) return value;
        if (value.startsWith('/')) return `${apiBase}${value}`;
        return `/icons/social/${getSocialIcon(value, name)}.png`;
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initNavbar, { once: true });
    else initNavbar();
</script>
