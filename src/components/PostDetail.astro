---
import Layout from '../layouts/Layout.astro';
const { slug = '' } = Astro.props;
---

<Layout title="动态详情 | 凌巽的酒馆">
    <main data-post-slug={slug} class="dynamic-post-page" aria-labelledby="post-title">
        <div class="site-container dynamic-post-page__inner">
            <a href="/posts/" class="dynamic-post-page__back"><span aria-hidden="true">←</span> 返回最近手记</a>
            <div id="dynamic-post-loading" class="dynamic-state">正在打开这张手记……</div>

            <article id="dynamic-post" class="hidden">
                <header class="dynamic-post-page__header" data-reveal>
                    <div class="dynamic-post-page__meta"><span id="post-date" class="meta"></span><span id="post-tag" class="tag"></span></div>
                    <h1 id="post-title"></h1>
                    <p id="post-desc"></p>
                </header>
                <div id="post-media" class="dynamic-post-page__media hidden"></div>
                <nav id="story-contents" class="story-contents hidden" aria-label="故事章节目录">
                    <details open>
                        <summary>章节目录 <span id="story-chapter-count" class="meta"></span></summary>
                        <ol id="story-chapter-links"></ol>
                    </details>
                </nav>
                <div id="post-content" class="markdown-body dynamic-post-page__body" data-reveal style="--reveal-delay: 120ms"></div>
                <aside id="post-resources" class="dynamic-post-page__resources hidden"></aside>
            </article>

            <section id="comments-section" class="comments-section hidden" aria-labelledby="comments-title">
                <div class="comments-section__heading">
                    <div><div class="eyebrow">酒馆留言 / Guestbook</div><h2 id="comments-title">留下你的话</h2></div>
                    <div id="comments-count" class="meta">0 条留言</div>
                </div>

                <form id="comment-form" class="comment-form paper-card">
                    <input type="hidden" name="parent_id" />
                    <div id="reply-context" class="reply-context hidden"></div>
                    <p class="comment-form__notice">请友善发言，尊重彼此；评论中禁止发布色情、暴力、血腥或其他令人不适的内容。</p>
                    <label>留言 ID<input name="author_id" required maxlength="80" placeholder="你的名字 / ID" /></label>
                    <label>留言内容<textarea name="content" required maxlength="1000" placeholder="写下一段话……"></textarea></label>
                    <div class="comment-form__actions">
                        <button id="comment-submit" class="button button--accent" type="submit">发送留言 <span aria-hidden="true">→</span></button>
                        <button id="cancel-reply" class="button button--quiet hidden" type="button">取消回复</button>
                        <span id="comment-status" class="comment-status" role="status" aria-live="polite"></span>
                    </div>
                </form>
                <div id="comments-list" class="comments-list"></div>
            </section>
        </div>
    </main>
</Layout>

<script>
    import { renderStoryChapters } from '../lib/storyChapters';
    import { postTagLabel } from '../lib/postLabels';
    import {
        escapeHtml,
        fetchPublic,
        markdownToHtml,
        postPublic,
        submitPublicForm,
        toApiUrl,
        type PostComment,
        type PublicPost,
    } from '../lib/publicContent';
    import { loadSiteContent, siteText, siteFormat } from '../lib/siteContent';

    let activeSlug = '';
    let comments: PostComment[] = [];

    const initPostPage = async () => {
        const slug = document.querySelector<HTMLElement>('[data-post-slug]')?.dataset.postSlug || new URLSearchParams(window.location.search).get('slug');
        const loading = document.getElementById('dynamic-post-loading');
        const article = document.getElementById('dynamic-post');
        if (!slug || !loading || !article) return;
        activeSlug = slug;
        await loadSiteContent();
        loading.textContent = siteText('post.loading', '正在打开这张手记……');

        const post = await fetchPublic<PublicPost>(`/api/public/posts/${encodeURIComponent(slug)}`);
        if (!post) {
            loading.textContent = siteText('post.not_found', '这张手记暂时找不到。');
            return;
        }

        document.title = siteFormat('site.post_title', '{title} | {brand}', { title: post.title, brand: siteText('site.brand_name', '凌巽的酒馆') });
        setText('post-date', post.date);
        setText('post-tag', postTagLabel(post.tag));
        setText('post-title', post.title);
        setText('post-desc', post.desc);

        const content = document.getElementById('post-content');
        if (content) {
            const source = post.content || post.desc || '';
            const isStory = post.is_character_story || post.slug === 'post-lingxun-s_story';
            content.innerHTML = isStory ? renderStoryChapters(source) : markdownToHtml(source);
            if (isStory) {
                article.classList.add('story-article');
                const headings = Array.from(content.querySelectorAll('h2'));
                const contents = document.getElementById('story-contents');
                const links = document.getElementById('story-chapter-links');
                headings.forEach((heading, index) => {
                    heading.id = `story-chapter-${index + 1}`;
                    heading.setAttribute('tabindex', '-1');
                });
                if (links && headings.length) {
                    links.replaceChildren(...headings.map(heading => {
                        const item = document.createElement('li');
                        const anchor = document.createElement('a');
                        anchor.href = `#${heading.id}`;
                        anchor.textContent = heading.textContent;
                        anchor.addEventListener('click', () => heading.focus({ preventScroll: true }));
                        item.append(anchor);
                        return item;
                    }));
                    document.getElementById('story-chapter-count')!.textContent = siteFormat('post.chapters_count', '{count} 节', { count: headings.length });
                    contents?.classList.remove('hidden');
                }
                content.querySelectorAll('p').forEach(paragraph => {
                    if (/^【(?:本章|全书)完】$/.test(paragraph.textContent?.trim() || '')) paragraph.classList.add('story-chapter-end');
                });
            }
        }

        renderPostResources(post);

        loading.classList.add('hidden');
        article.classList.remove('hidden');
        const chapterId = window.location.hash.slice(1);
        if (/^story-chapter-\d+$/.test(chapterId)) {
            await document.fonts.ready;
            document.getElementById(chapterId)?.scrollIntoView({ block: 'start', behavior: 'instant' });
        }

        const commentsSection = document.getElementById('comments-section');
        commentsSection?.classList.remove('hidden');
        setupCommentForm();
        await loadComments();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPostPage, { once: true });
    else initPostPage();

    function setText(id: string, value: string) {
        const element = document.getElementById(id);
        if (element) element.textContent = value;
    }

    function renderPostResources(post: PublicPost) {
        const media = document.getElementById('post-media');
        const resources = document.getElementById('post-resources');
        const imageUrls = [post.cover_url, ...(post.image_urls || [])].filter((url, index, values): url is string => Boolean(url) && values.indexOf(url) === index);
        if (media && imageUrls.length) {
            media.innerHTML = imageUrls.map((url, index) => `<figure><img src="${escapeHtml(toApiUrl(url))}" alt="${escapeHtml(`${post.title} ${index + 1}`)}" loading="${index === 0 ? 'eager' : 'lazy'}" decoding="async" /><figcaption>${escapeHtml(siteFormat('post.media_caption', '旅途记录 {index} / {count}', { index: String(index + 1).padStart(2, '0'), count: imageUrls.length }))}</figcaption></figure>`).join('');
            media.classList.remove('hidden');
        }
        const attachments = (post.attachments || []).filter(Boolean);
        const links = (post.links || []).filter((item) => item?.url);
        if (resources && (attachments.length || links.length)) {
            resources.innerHTML = `<div class="eyebrow">随手带上的资料</div>${attachments.length ? `<h2 data-resource-title="attachments">附件</h2><ul>${attachments.map((url) => `<li><a href="${escapeHtml(toApiUrl(url))}" target="_blank" rel="noopener noreferrer">${escapeHtml(url.split('/').pop() || siteText('post.attachment_fallback', '打开附件'))} ↗</a></li>`).join('')}</ul>` : ''}${links.length ? `<h2 data-resource-title="links">相关网页</h2><ul>${links.map((item) => `<li><a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(item.label || item.url)} ↗</a></li>`).join('')}</ul>` : ''}`;
            resources.classList.remove('hidden');
        }
    }

    async function loadComments() {
        if (!activeSlug) return;
        comments = await fetchPublic<PostComment[]>(`/api/public/posts/${encodeURIComponent(activeSlug)}/comments`) || [];
        renderComments();
    }

    function renderComments() {
        const list = document.getElementById('comments-list');
        const count = document.getElementById('comments-count');
        if (!list) return;
        if (count) count.textContent = siteFormat('post.comments_count', '{count} 条留言', { count: comments.length });

        const roots = comments.filter((item) => !item.parent_id);
        if (!roots.length) {
            list.innerHTML = `<div class="comments-empty">${escapeHtml(siteText('post.comments_empty', '还没有留言，先在柜台边写下第一句吧。'))}</div>`;
            return;
        }

        list.innerHTML = roots.map((comment) => renderComment(comment, false)).join('');
        bindCommentActions();
    }

    function renderComment(comment: PostComment, isReply: boolean) {
        const replies = comments.filter((item) => item.parent_id === comment.id);
        return `
            <div class="${isReply ? 'comment comment--reply' : 'comment'}">
                <article class="comment__card">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
                            <span class="comment__author">${escapeHtml(comment.author_id)}</span>
                            <time class="meta">${escapeHtml(formatDate(comment.created_at))}</time>
                        </div>
                        <div class="comment__content">${escapeHtml(comment.content)}</div>
                        <div class="comment__actions">
                            <button type="button" data-like-comment="${comment.id}">${escapeHtml(siteFormat('post.like', '喜欢 {count}', { count: comment.like_count }))}</button>
                            <button type="button" data-reply-comment="${comment.id}" data-reply-author="${escapeHtml(comment.author_id)}">${escapeHtml(siteText('post.reply', '回复'))}</button>
                        </div>
                    </div>
                </article>
                ${replies.map((reply) => renderComment(reply, true)).join('')}
            </div>
        `;
    }

    function bindCommentActions() {
        document.querySelectorAll('[data-like-comment]').forEach((button) => {
            button.addEventListener('click', async () => {
                const id = (button as HTMLElement).dataset.likeComment;
                if (!id || !activeSlug) return;
                const updated = await postPublic<PostComment>(`/api/public/posts/${encodeURIComponent(activeSlug)}/comments/${id}/like`);
                if (!updated) return;
                comments = comments.map((item) => item.id === updated.id ? updated : item);
                renderComments();
            });
        });

        document.querySelectorAll('[data-reply-comment]').forEach((button) => {
            button.addEventListener('click', () => {
                const target = button as HTMLElement;
                startReply(target.dataset.replyComment || '', target.dataset.replyAuthor || '');
            });
        });
    }

    function setupCommentForm() {
        const form = document.getElementById('comment-form') as HTMLFormElement | null;
        const cancel = document.getElementById('cancel-reply');
        if (!form) return;

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!activeSlug) return;
            setCommentStatus(siteText('post.sending', '正在发送……'));
            const submit = document.getElementById('comment-submit') as HTMLButtonElement | null;
            if (submit) submit.disabled = true;

            const data = new FormData(form);
            const created = await submitPublicForm<PostComment>(`/api/public/posts/${encodeURIComponent(activeSlug)}/comments`, data);
            if (submit) submit.disabled = false;

            if (!created) {
                setCommentStatus(siteText('post.send_failed', '发送失败，请稍后再试。'));
                return;
            }

            form.reset();
            clearReply();
            setCommentStatus(siteText('post.sent', '留言已送达。'));
            await loadComments();
        });

        cancel?.addEventListener('click', clearReply);
    }

    function startReply(commentId: string, author: string) {
        const form = document.getElementById('comment-form') as HTMLFormElement | null;
        const parent = form?.elements.namedItem('parent_id') as HTMLInputElement | null;
        const context = document.getElementById('reply-context');
        const cancel = document.getElementById('cancel-reply');
        const content = form?.elements.namedItem('content') as HTMLTextAreaElement | null;
        if (parent) parent.value = commentId;
        if (context) {
            context.textContent = siteFormat('post.replying', '正在回复：{author}', { author });
            context.classList.remove('hidden');
        }
        cancel?.classList.remove('hidden');
        content?.focus();
        form?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function clearReply() {
        const form = document.getElementById('comment-form') as HTMLFormElement | null;
        const parent = form?.elements.namedItem('parent_id') as HTMLInputElement | null;
        const context = document.getElementById('reply-context');
        const cancel = document.getElementById('cancel-reply');
        if (parent) parent.value = '';
        context?.classList.add('hidden');
        cancel?.classList.add('hidden');
    }

    function setCommentStatus(value: string) {
        const status = document.getElementById('comment-status');
        if (status) status.textContent = value;
    }

    function formatDate(value: string | null | undefined) {
        if (!value) return '';
        const normalized = /([zZ]|[+-]\d{2}:?\d{2})$/.test(value) ? value : `${value}Z`;
        const date = new Date(normalized);
        if (Number.isNaN(date.getTime())) return value;
        return `${new Intl.DateTimeFormat('zh-CN', {
            timeZone: 'Asia/Shanghai',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
        }).format(date)} BJT`;
    }
</script>

<style is:global>
    .story-contents { margin: 2rem auto 0; max-width: 700px; padding-block: 1.2rem; border-block: 1px solid var(--line); }
    .story-contents summary { cursor: pointer; color: var(--paper); font-family: var(--font-serif); font-size: 1.25rem; }
    .story-contents summary .meta { margin-left: 1rem; color: var(--steel-soft); font-size: .75rem; }
    .story-contents ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .25rem 1.5rem; padding: 0; margin: 1rem 0 0; list-style: none; }
    .story-contents a { display: flex; align-items: center; min-height: 44px; padding-block: .4rem; color: var(--paper-muted); line-height: 1.6; overflow-wrap: anywhere; }
    .story-contents a:hover { color: var(--red-soft); }
    .story-article .dynamic-post-page__body { max-width: 700px; font-size: 1.125rem; line-height: 2; }
    .story-article .markdown-body h2 { display: block; padding-top: 1.4rem; padding-bottom: .8rem; margin-top: 3.5rem; margin-bottom: 1.5rem; border-top: 1px solid var(--line); border-bottom: 0; font-size: 1.85rem; line-height: 1.5; scroll-margin-top: 110px; }
    .story-article .markdown-body p { margin-bottom: 1.25em; }
    .story-article .markdown-body .story-chapter-end { margin-block: 2rem; color: var(--steel-soft); font-family: var(--font-sans); font-size: .8rem; text-align: center; }
    @media (max-width: 680px) {
        .story-contents ol { grid-template-columns: 1fr; }
        .story-article .dynamic-post-page__body { font-size: 1.0625rem; line-height: 1.95; }
        .story-article .markdown-body h2 { font-size: 1.5rem; margin-top: 2.5rem; }
    }
    .dynamic-post-page { min-height: 100vh; padding-block: 9rem 6rem; background: var(--ink); color: var(--paper); }
    .dynamic-post-page__inner { max-width: 900px; }
    .dynamic-post-page__back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--steel-soft); font-size: 0.9rem; transition: color 180ms ease; }
    .dynamic-post-page__back:hover { color: var(--red-soft); }
    .dynamic-state { margin-top: 3rem; padding: 1rem 0; color: var(--paper-muted); font-family: var(--font-serif); }
    .dynamic-post-page__header { max-width: 780px; margin-top: 3rem; padding-bottom: 2.4rem; border-bottom: 1px solid var(--line); }
    .dynamic-post-page__meta { display: flex; align-items: center; gap: 0.8rem; }
    .dynamic-post-page__meta .meta { color: var(--steel-soft); }
    .dynamic-post-page__meta .tag { border-color: rgba(155, 39, 49, 0.5); color: var(--red-soft); }
    .dynamic-post-page__header h1 { margin: 1.15rem 0 0.9rem; color: var(--paper); font-family: var(--font-serif); font-size: clamp(2.4rem, 7vw, 5.2rem); line-height: 1.08; }
    .dynamic-post-page__header p { max-width: 680px; margin: 0; color: var(--paper-muted); font-size: 1.05rem; line-height: 1.9; }
    .dynamic-post-page__media { display: grid; gap: 0.8rem; margin-top: 2.5rem; }
    .dynamic-post-page__media figure { margin: 0; overflow: hidden; border: 1px solid var(--line); background: var(--surface-card); }
    .dynamic-post-page__media img { display: block; width: 100%; max-height: 620px; object-fit: cover; }
    .dynamic-post-page__media figcaption { padding: 0.55rem 0.75rem; color: var(--paper-muted); font-family: var(--font-mono); font-size: 0.72rem; }
    .dynamic-post-page__resources { margin-top: 2rem; padding: 1rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--paper-muted); }
    .dynamic-post-page__resources h2 { margin: 0.9rem 0 0.25rem; color: var(--paper); font-family: var(--font-serif); font-size: 1.2rem; }
    .dynamic-post-page__resources ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0; padding-left: 1.1rem; }
    .dynamic-post-page__resources a { color: var(--red-soft); text-decoration: underline; text-underline-offset: 0.2em; }
    .markdown-body { color: var(--paper); font-family: var(--font-serif); font-size: 1.08rem; line-height: 2; }
    .dynamic-post-page__body { max-width: 700px; margin: 3rem auto 0; }
    .markdown-body h1, .markdown-body h2, .markdown-body h3 { color: var(--paper); font-family: var(--font-serif); line-height: 1.3; }
    .markdown-body h1 { font-size: 2.2rem; }
    .markdown-body h2 { display: inline-block; margin: 2.4em 0 0.8em; padding-bottom: 0.3em; border-bottom: 1px solid rgba(155, 39, 49, 0.4); font-size: 1.7rem; }
    .markdown-body h3 { margin-top: 2em; font-size: 1.35rem; }
    .markdown-body p { margin: 0 0 1.5em; }
    .markdown-body strong { color: var(--red-soft); font-weight: 700; }
    .markdown-body blockquote { margin: 2em 0; padding: 1rem 1.25rem; border-left: 3px solid var(--gold); background: rgba(211, 168, 61, 0.1); color: var(--paper-muted); font-style: italic; }
    .markdown-body ul { margin: 1.5em 0; padding-left: 1.35em; }
    .markdown-body li { margin-bottom: 0.65em; }
    .markdown-body code { padding: 0.15em 0.35em; background: var(--surface-card-hover); color: var(--red-soft); font-family: var(--font-mono); font-size: 0.82em; }
    .comments-section { margin-top: 5rem; padding-top: 2rem; border-top: 1px solid var(--line); }
    .comments-section__heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
    .comments-section__heading .eyebrow { color: var(--red-soft); }
    .comments-section__heading h2 { margin: 0.8rem 0 0; color: var(--paper); font-family: var(--font-serif); font-size: 2rem; }
    .comments-section__heading .meta { color: var(--steel-soft); }
    .comment-form { display: grid; gap: 1rem; padding: 1.25rem; background: var(--surface-paper); color: var(--paper); }
    .comment-form label { display: grid; gap: 0.4rem; color: var(--paper-muted); font-size: 0.86rem; }
    .comment-form input, .comment-form textarea { width: 100%; border: 1px solid var(--line); background: var(--ink-soft); color: var(--paper); outline: none; padding: 0.75rem 0.85rem; }
    .comment-form input:focus, .comment-form textarea:focus { border-color: var(--red); box-shadow: 0 0 0 3px rgba(155, 39, 49, 0.1); }
    .comment-form textarea { min-height: 8rem; resize: vertical; }
    .comment-form__notice { margin: 0; padding: 0.7rem 0.85rem; background: rgba(211, 168, 61, 0.12); color: var(--paper-muted); font-size: 0.86rem; line-height: 1.7; }
    .comment-form__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.7rem; }
    .comments-section .button--accent { border-color: var(--red-soft); color: var(--red-soft); }
    .comment-status { color: var(--red-soft); font-size: 0.86rem; }
    .reply-context { padding: 0.6rem 0.75rem; border-left: 2px solid var(--gold); color: var(--paper-muted); font-size: 0.86rem; }
    .comments-list { display: grid; gap: 0.8rem; margin-top: 1rem; }
    .comment--reply { margin-left: clamp(1rem, 5vw, 3rem); margin-top: 0.7rem; }
    .comment__card { padding: 1rem 1.1rem; border: 1px solid var(--line); background: var(--surface-card); }
    .comment__card > div { min-width: 0; }
    .comment__author { color: var(--red-soft); font-family: var(--font-serif); font-size: 1.05rem; font-weight: 700; overflow-wrap: anywhere; }
    .comment__content { margin-top: 0.55rem; color: var(--paper-muted); font-size: 0.96rem; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
    .comment__actions { display: flex; gap: 0.9rem; margin-top: 0.8rem; }
    .comment__actions button { padding: 0; border: 0; background: transparent; color: var(--steel-soft); font-family: var(--font-mono); font-size: 0.72rem; cursor: pointer; }
    .comment__actions button:hover { color: var(--red-soft); }
    .comments-empty { padding: 1.5rem; border: 1px dashed var(--line); color: var(--paper-muted); text-align: center; }

    @media (max-width: 680px) {
        .dynamic-post-page { padding-top: 7.5rem; }
        .dynamic-post-page__header { margin-top: 2.25rem; }
        .dynamic-post-page__header h1 { font-size: clamp(2.15rem, 11vw, 3.4rem); }
        .dynamic-post-page__body { margin-top: 2rem; font-size: 1.04rem; line-height: 1.9; }
        .comments-section__heading { align-items: flex-start; flex-direction: column; }
        .comment-form { padding: 1rem; }
    }
</style>
