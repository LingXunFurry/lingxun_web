---
import { getCollection } from 'astro:content';
import { postTagLabel } from '../lib/postLabels';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date.replace(/\./g, '-')).valueOf() - new Date(a.data.date.replace(/\./g, '-')).valueOf());
const latestPosts = sortedPosts.slice(0, 3);
---

<section class="home-feed-section" aria-labelledby="home-feed-title">
    <div class="site-container home-feed-section__inner">
        <header class="home-feed-section__heading" data-reveal>
            <div>
                <div class="eyebrow">最近手记 / Tavern Notes</div>
                <h2 id="home-feed-title" class="section-title">柜台边的<em>新消息</em></h2>
            </div>
            <p class="home-feed-section__heading-copy">每次更新都像一张刚贴上公告板的便签，写给后来进门的人。</p>
        </header>

        <div id="homepage-post-grid" class="home-feed-section__grid" data-public-pending aria-busy="true" data-reveal style="--reveal-delay: 120ms">
            {latestPosts.map((post, index) => (
                <a href={`/posts/${post.id}`} class="note-card paper-card paper-enter" style={`animation-delay: ${index * 100}ms`}>
                    <div class="note-card__top"><span class="meta">{post.data.date}</span><span class="tag">{postTagLabel(post.data.tag)}</span></div>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.desc}</p>
                    <span class="note-card__more">阅读手记 <span aria-hidden="true">→</span></span>
                </a>
            ))}
        </div>

        <div class="home-feed-section__footer" data-reveal style="--reveal-delay: 220ms">
            <span class="meta">NOTES / 记录持续更新</span>
            <a href="/posts/" class="button button--accent">查阅全部手记 <span aria-hidden="true">→</span></a>
        </div>
    </div>
</section>

<script>
    import { escapeHtml, fetchPublic, initPublicContent, toApiUrl, type PublicPost } from '../lib/publicContent';
    import { loadSiteContent, siteText } from '../lib/siteContent';
    import { postTagLabel } from '../lib/postLabels';

    const initHomepageFeed = async () => {
        const grid = document.getElementById('homepage-post-grid');
        const posts = await fetchPublic<PublicPost[]>('/api/public/posts');
        if (!grid || !posts) return;
        await loadSiteContent();
        grid.innerHTML = posts.slice(0, 3).map(renderPostCard).join('');
    };
    initPublicContent('#homepage-post-grid', initHomepageFeed);

    function renderPostCard(post: PublicPost, index: number) {
        const cover = post.cover_url ? `<img src="${escapeHtml(toApiUrl(post.cover_url))}" alt="" loading="lazy" decoding="async" />` : '';
        return `
            <a href="/post/?slug=${encodeURIComponent(post.slug)}" class="note-card paper-card paper-enter" style="animation-delay: ${index * 100}ms">
                ${cover ? `<div class="note-card__cover">${cover}</div>` : ''}
                <div class="note-card__top"><span class="meta">${escapeHtml(post.date)}</span>${post.is_pinned ? `<span class="tag">${escapeHtml(siteText('posts.pinned', '置顶'))}</span>` : ''}<span class="tag">${escapeHtml(postTagLabel(post.tag))}</span></div>
                <h3>${escapeHtml(post.title)}</h3>
                <p>${escapeHtml(post.desc)}</p>
                <span class="note-card__more">阅读手记 <span aria-hidden="true">→</span></span>
            </a>
        `;
    }
</script>

<style is:global>
    .home-feed-section { padding-block: clamp(5rem, 12vw, 10rem); background: var(--ink); }
    .home-feed-section__heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
    .home-feed-section__heading-copy { max-width: 23rem; margin: 0; color: var(--paper-muted); }
    .home-feed-section__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
    .note-card { display: flex; flex-direction: column; min-height: 18rem; padding: 1.35rem; color: var(--paper); }
    .note-card__cover { order: -1; margin: -1.35rem -1.35rem 1.25rem; overflow: hidden; }
    .note-card__cover img { display: block; width: 100%; aspect-ratio: 16 / 7; object-fit: cover; filter: saturate(0.65); }
    .note-card__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; }
    .note-card h3 { margin: 1.5rem 0 0.6rem; color: var(--paper); font-family: var(--font-serif); font-size: 1.35rem; line-height: 1.35; }
    .note-card p { margin: 0; color: var(--paper-muted); line-height: 1.8; }
    .note-card__more { display: inline-flex; gap: 0.5rem; align-items: center; margin-top: auto; padding-top: 1.6rem; color: var(--gold); font-size: 0.86rem; }
    .note-card:hover .note-card__more { color: var(--paper); }
    .home-feed-section__footer { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 2rem; }

    @media (max-width: 820px) {
        .home-feed-section__heading { align-items: start; flex-direction: column; }
        .home-feed-section__grid { grid-template-columns: 1fr; }
        .note-card { min-height: 0; }
    }

    @media (max-width: 480px) {
        .home-feed-section__footer { align-items: stretch; flex-direction: column; }
    }
</style>
