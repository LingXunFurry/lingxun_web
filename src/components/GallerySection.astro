---
import { Image } from 'astro:assets';
import SceneOrnament from './SceneOrnament.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{jpeg,jpg,png,PNG,webp}');
const imagePaths = Object.values(images);
const galleryImages = await Promise.all(imagePaths.map(async (img) => (await img()).default));
const previewImages = galleryImages.slice(0, 3);
---

<section id="gallery-section" class="home-gallery-section" aria-labelledby="home-gallery-title">
    <SceneOrnament kind="photo" />
    <div class="site-container home-gallery-section__inner">
        <div class="home-gallery-section__intro" data-reveal>
            <div class="eyebrow">旅途留影 / Visual Archive</div>
            <h2 id="home-gallery-title" class="section-title">把路上的光，<em>留在墙上</em></h2>
            <p class="section-copy">公会委托、城镇生活和酒馆片段，都先在这里留下一个位置。完整档案可以按类别慢慢翻看。</p>
            <a href="/gallery/" class="button button--accent">进入旅途留影 <span aria-hidden="true">→</span></a>
        </div>

        <div id="homepage-gallery-grid" class="home-gallery-section__grid" data-public-pending aria-busy="true" data-reveal style="--reveal-delay: 120ms">
            {previewImages.map((img, index) => (
                <a href="/gallery/" class={`home-gallery-card paper-card ${index === 1 ? 'home-gallery-card--offset' : ''}`}>
                    <img width="600" height="800" alt={`凌巽旅途留影 ${index + 1}`} loading="lazy" decoding="async" />
                    <span class="home-gallery-card__caption"><span>{['城镇生活', '活动记录', '酒馆片段'][index] ?? '旅途留影'}</span><span class="meta">0{index + 1}</span></span>
                </a>
            ))}
        </div>
    </div>
</section>

<script>
    import { escapeHtml, imageAttributes, fetchRequired as fetchPublic, initPublicContent, type GalleryPhoto } from '../lib/publicContent';
    import { loadSiteContent, siteText } from '../lib/siteContent';

    const initHomepageGallery = async () => {
        const grid = document.getElementById('homepage-gallery-grid');
        const photos = await fetchPublic<GalleryPhoto[]>('/api/public/gallery');
        if (!grid || !photos) return;
        await loadSiteContent();
        const managedPhotos = photos.some((photo) => photo.is_home_gallery) || siteText('home.media_managed', '') === 'true'
            ? photos.filter((photo) => photo.is_home_gallery).sort((a, b) => (a.home_order ?? 0) - (b.home_order ?? 0) || a.id - b.id)
            : photos;

        grid.innerHTML = managedPhotos.slice(0, 3).map((photo, index) => `
            <a href="/gallery/" class="home-gallery-card paper-card ${index === 1 ? 'home-gallery-card--offset' : ''}">
                <img ${imageAttributes(photo.file_url, photo.image, '(min-width: 900px) 25vw, 45vw')} alt="${escapeHtml(photo.title || photo.original_filename || `凌巽旅途留影 ${index + 1}`)}" loading="lazy" decoding="async" />
                <span class="home-gallery-card__caption"><span>${escapeHtml(photo.title || siteText('gallery.default_title', '旅途留影'))}</span><span class="meta">0${index + 1}</span></span>
                ${[photo.category, photo.date, photo.location].filter(Boolean).length ? `<span class="home-gallery-card__note">${[photo.category, photo.date, photo.location].filter(Boolean).map(value => `<span>${escapeHtml(value!)}</span>`).join('')}</span>` : ''}
            </a>
        `).join('');
    };
    initPublicContent('#homepage-gallery-grid', initHomepageGallery);
</script>

<style is:global>
    .home-gallery-section { padding-block: clamp(5rem, 12vw, 10rem); background: var(--ink); color: var(--paper); }
    .home-gallery-section .eyebrow { color: var(--red); }
    .home-gallery-section .section-title { color: var(--paper); }
    .home-gallery-section .section-title em { color: var(--steel); }
    .home-gallery-section .section-copy { color: var(--paper-muted); }
    .home-gallery-section .button--accent { border-color: var(--red); color: var(--red); }
    .home-gallery-section .button--accent:hover { background: rgba(155, 39, 49, 0.08); }

    .home-gallery-section__inner { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
    .home-gallery-section__intro { max-width: 30rem; }
    .home-gallery-section__intro .button { margin-top: 2rem; }
    .home-gallery-section__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; align-items: start; }
    .home-gallery-card { position: relative; display: block; overflow: hidden; padding: 0.65rem; border-color: var(--line); background: var(--surface-card); color: var(--paper); }
    .home-gallery-card::before, .home-gallery-card::after { content: ''; position: absolute; inset: auto; z-index: 1; width: 1.25rem; height: 1.25rem; pointer-events: none; border-color: var(--gold); border-style: solid; }
    .home-gallery-card::before { top: .25rem; left: .25rem; border-width: 2px 0 0 2px; }
    .home-gallery-card::after { bottom: .25rem; right: .25rem; border-width: 0 2px 2px 0; }
    .home-gallery-card__note { display: flex; flex-wrap: wrap; gap: .3rem .75rem; margin: .55rem .2rem .25rem; padding-top: .55rem; border-top: 1px solid var(--line); color: var(--steel-soft); font-size: .72rem; line-height: 1.6; overflow-wrap: anywhere; }
    .home-gallery-card__caption > span:first-child { min-width: 0; overflow-wrap: anywhere; }
    .home-gallery-card:hover { background: var(--surface-card-hover); border-color: var(--red); }
    .home-gallery-card--offset { margin-top: 2.25rem; }
    .home-gallery-card img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; filter: saturate(0.7) contrast(1.04); transition: filter 220ms ease, transform 500ms ease; }
    .home-gallery-card:hover img { filter: saturate(1) contrast(1.05); transform: scale(1.03); }
    .home-gallery-card__caption { display: flex; justify-content: space-between; gap: 0.4rem; padding: 0.65rem 0.2rem 0.15rem; font-family: var(--font-serif); font-size: 0.9rem; }
    .home-gallery-card__caption .meta { color: var(--steel-soft); }

    @media (max-width: 820px) {
        .home-gallery-section__inner { grid-template-columns: 1fr; }
        .home-gallery-section__intro { max-width: 38rem; }
    }

    @media (max-width: 520px) {
        .home-gallery-section__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .home-gallery-card--offset { margin-top: 1.2rem; }
    }
    @media (prefers-reduced-motion: reduce) { .home-gallery-card img { transition: none; } }
</style>
