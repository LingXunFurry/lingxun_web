---
import SceneOrnament from './SceneOrnament.astro';
import '../styles/record-switch.css';
---
<section id="story-section" class="story-section" aria-labelledby="story-title" data-public-pending aria-busy="true">
    <SceneOrnament kind="book" />
    <div class="site-container story-section__inner">
        <header class="story-section__heading" data-reveal>
            <div class="eyebrow">角色故事 / Character Stories</div>
            <h2 id="story-title"><span id="story-title-main">故事</span><em id="story-title-accent">集</em></h2>
            <div class="story-selection-controls"><div id="story-tabs" class="record-tabs" aria-label="选择角色故事"></div></div>
            <p id="story-intro" class="section-copy">不同的来处，各自的旅途。故事从这里继续。</p>
        </header>
        <p id="story-empty" class="section-copy" hidden>角色故事还没有放上书架。</p>
        <div class="story-book-shell" data-reveal style="--reveal-delay: 140ms">
        <div class="story-book" aria-label="角色故事书">
            <div class="story-book__viewport"><div id="story-page" role="tabpanel" tabindex="0">
                <article class="story-book__summary">
                    <div class="story-book__meta"><span id="story-owner"></span><span id="story-state" class="tag"></span><span id="story-date" class="meta"></span></div>
                    <h3 id="story-post-title"></h3><p id="story-summary"></p>
                    <div class="story-book__actions"><a id="story-read" class="button button--accent" href="/posts/">点击阅读 <span aria-hidden="true">→</span></a><span id="story-latest" class="story-book__latest"></span></div>
                </article>
                <nav id="story-excerpts" class="story-book__chapters" aria-label="故事章节">
                    <div class="story-book__chapter-heading"><span id="story-chapters-label">篇章摘目</span><span id="story-chapters-count" class="meta"></span></div>
                    <ol id="story-excerpt-links"></ol><p id="story-no-chapters" hidden>新的篇章正在准备。</p>
                    <a id="story-all-chapters" href="/posts/">完整目录 <span aria-hidden="true">↗</span></a>
                </nav>
            </div></div>
        </div>
        <nav class="story-switch-arrows" aria-label="切换角色故事">
            <button id="story-prev" type="button" aria-label="上一篇角色故事" title="上一篇角色故事">←</button>
            <button id="story-next" type="button" aria-label="下一篇角色故事" title="下一篇角色故事">→</button>
        </nav>
        </div>
    </div>
</section>
<script>
    import { fetchRequired, initPublicContent, type PublicPost, type CharacterProfile } from '../lib/publicContent';
    import { loadSiteContent } from '../lib/siteContent';
    import { renderStoryChapters } from '../lib/storyChapters';
    import { characterChoice, recordTabs, recordTransition } from '../lib/recordSwitch';
    initPublicContent('#story-section', async () => {
        const [stories, characters] = await Promise.all([fetchRequired<PublicPost[]>('/api/public/stories'), fetchRequired<CharacterProfile[]>('/api/public/characters'), loadSiteContent()]);
        const section = document.getElementById('story-section')!, page = document.getElementById('story-page')!, tabs = document.getElementById('story-tabs')!;
        if (!stories.length) { document.getElementById('story-empty')!.hidden = false; section.querySelector<HTMLElement>('.story-book-shell')!.hidden = true; tabs.hidden = true; return; }
        let current = 0;
        let activate: (index: number) => void;
        const text = (id: string, value: string) => { document.getElementById(id)!.textContent = value; };
        const read = document.getElementById('story-read') as HTMLAnchorElement;
        const render = (index: number) => {
            current = index;
            const post = stories[index], owner = characters.find(item => item.id === post.story_character_id), base = `/post/?slug=${encodeURIComponent(post.slug)}`;
            const parsed = new DOMParser().parseFromString(renderStoryChapters(post.content || ''), 'text/html');
            const chapters = post.chapters?.length ? post.chapters.map(chapter => ({ title: [chapter.label !== chapter.title ? chapter.label : '', chapter.title].filter(Boolean).join(' · '), href: `${base}&chapter=${encodeURIComponent(chapter.slug)}` })) : Array.from(parsed.querySelectorAll('h2')).map((heading, number) => ({ title: heading.textContent || '', href: `${base}#story-chapter-${number + 1}` }));
            text('story-owner', owner?.name || '角色故事'); text('story-state', post.story_status === 'completed' ? '已完结' : post.story_status === 'serial' ? '连载中' : '整篇收录');
            text('story-date', post.date); text('story-post-title', post.title); text('story-summary', post.story_summary || post.desc);
            read.href = chapters[0]?.href || base;
            text('story-latest', post.chapters?.length ? `最新 · ${chapters.at(-1)!.title}` : `${chapters.length || '—'} 个篇章`);
            text('story-chapters-count', `${String(chapters.length).padStart(2, '0')} 章`);
            document.getElementById('story-excerpt-links')!.replaceChildren(...chapters.slice(0, 3).map((chapter, number) => {
                const li = document.createElement('li'), a = document.createElement('a'), label = document.createElement('span'), title = document.createElement('strong');
                label.className = 'meta'; label.textContent = String(number + 1).padStart(2, '0'); a.href = chapter.href; title.textContent = chapter.title; a.append(label, title); li.append(a); return li;
            }));
            (document.getElementById('story-all-chapters') as HTMLAnchorElement).href = base + '#story-contents';
            document.getElementById('story-no-chapters')!.hidden = chapters.length > 0;
            page.setAttribute('aria-labelledby', `story-page-tab-${index}`); activate?.(index);
        };
        const change = recordTransition([page], render);
        activate = recordTabs(tabs, stories.map(post => characterChoice(characters.find(item => item.id === post.story_character_id), post.title)), 'story-page', index => void change(index));
        const previous = document.getElementById('story-prev') as HTMLButtonElement, next = document.getElementById('story-next') as HTMLButtonElement;
        previous.disabled = next.disabled = stories.length < 2;
        previous.addEventListener('click', () => void change((current - 1 + stories.length) % stories.length, -1));
        next.addEventListener('click', () => void change((current + 1) % stories.length, 1));
        const mobile = matchMedia('(max-width: 720px)'), controls = section.querySelector('.story-selection-controls')!, arrows = section.querySelector('.story-switch-arrows')!;
        const positionArrows = () => {
            if (mobile.matches) { controls.prepend(previous); controls.append(next); }
            else arrows.replaceChildren(previous, next);
        };
        mobile.addEventListener('change', positionArrows); positionArrows();
        render(0);
    });
</script>
<style is:global>
    .story-section { background: var(--ink); color: var(--paper); padding-block: 4rem; overflow-anchor: none; }
    .story-section__inner { display: grid; gap: 1.5rem; }
    .story-section__heading { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: .7rem 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
    .story-section__heading .eyebrow { grid-column: 1 / -1; }
    .story-section__heading h2 { margin: 0; font: 700 2.6rem/1.3 var(--font-serif); }
    .story-section__heading h2 em { color: var(--steel-soft); font-style: normal; font-weight: 400; }
    .story-section__heading .section-copy { grid-column: 1 / -1; margin: 0; font-size: .85rem; }
    #story-tabs { justify-content: flex-end; }
    .story-selection-controls { min-width: 0; display: flex; align-items: center; justify-content: flex-end; }
    .story-book-shell[hidden], #story-empty[hidden], #story-no-chapters[hidden], #story-tabs[hidden] { display: none; }
    .story-book-shell { position: relative; min-width: 0; }
    :is(.story-switch-arrows, .story-selection-controls) > button { width: 44px; height: 48px; display: grid; place-items: center; padding: 0; border: 0; background: transparent; color: var(--gold); font: 2rem var(--font-serif); cursor: pointer; transition: transform .2s, color .2s, text-shadow .2s; }
    .story-switch-arrows button { position: absolute; top: calc(50% - 24px); }
    #story-prev { left: -56px; } #story-next { right: -56px; }
    :is(.story-switch-arrows, .story-selection-controls) > button:disabled { opacity: .25; cursor: default; }
    :is(.story-switch-arrows, .story-selection-controls) > button:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; border-radius: var(--radius-control); }
    @media (hover: hover) { .story-switch-arrows button:not(:disabled):hover { transform: translateY(-3px); color: color-mix(in srgb, var(--gold) 65%, var(--paper)); text-shadow: 0 2px 14px color-mix(in srgb, var(--gold) 35%, transparent); } }
    #story-page { position: relative; display: grid; height: 100%; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rem; }
    .story-book__viewport { height: 100%; min-width: 0; overflow: clip; }
    .story-book { position: relative; min-width: 0; height: 460px; box-sizing: border-box; border: 1px solid var(--line); border-radius: 8px; padding: 2.5rem; background: var(--surface-paper) url('/images/decor/paper-grain.svg'); box-shadow: 5px 5px 0 var(--ink-soft), 6px 6px 0 var(--line), 9px 9px 0 var(--ink-soft), 10px 10px 0 var(--line-soft); }
    .story-book::before { content: ''; position: absolute; left: calc(50% - 14px); width: 28px; top: 0; bottom: 0; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ink) 70%, transparent), transparent); border-left: 1px solid var(--line-soft); pointer-events: none; }
    .story-book::after { content: ''; position: absolute; right: 2.5rem; top: -1px; width: 18px; height: 35px; background: var(--red-soft); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%); pointer-events: none; }
    .story-book__summary { min-width: 0; min-height: 0; display: flex; flex-direction: column; }
    .story-book__meta { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem; color: var(--steel-soft); font-size: .8rem; }
    .story-book__meta > span:first-child { color: var(--red-soft); font-weight: 700; }
    #story-post-title { position: relative; flex-shrink: 0; margin: 1.1rem 0; padding-bottom: 1rem; font: 700 2.8rem/1.3 var(--font-serif); overflow-wrap: anywhere; }
    #story-post-title::after { content: ''; position: absolute; left: 0; bottom: 0; width: 4rem; border-top: 2px solid var(--red-soft); }
    #story-summary { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; max-width: 35rem; margin: 0 0 1rem; color: var(--paper-muted); font: 400 1rem/1.9 var(--font-sans); white-space: pre-line; overflow-wrap: anywhere; }
    .story-book__actions { display: flex; align-items: center; gap: .7rem 1rem; flex-wrap: wrap; margin-top: auto; flex-shrink: 0; }
    .story-book__latest { color: var(--steel-soft); font-size: .8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
    .story-book__chapters { min-width: 0; min-height: 0; padding: .4rem 0 0 1rem; display: flex; flex-direction: column; }
    .story-book__chapter-heading { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: .8rem; font-size: .85rem; font-weight: 700; color: var(--steel-soft); }
    .story-book__chapter-heading .meta, .story-book__chapters li .meta { color: var(--gold); font-weight: 400; }
    .story-book__actions .button, #story-all-chapters { font-weight: 700; }
    .story-book__chapters ol { list-style: none; padding: 0; margin: 0; }
    .story-book__chapters li { border-top: 1px solid var(--line-soft); }
    .story-book__chapters li a { display: flex; align-items: baseline; gap: 1rem; min-height: 52px; padding-block: 1rem; line-height: 1.6; }
    .story-book__chapters strong { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font: 700 1rem/1.6 var(--font-serif); overflow-wrap: anywhere; }
    .story-book__chapters a:hover { color: var(--gold); }
    #story-all-chapters { display: inline-flex; gap: 1rem; align-items: center; min-height: 44px; margin-top: auto; color: var(--red-soft); font-size: .85rem; }
    #story-no-chapters { color: var(--steel-soft); line-height: 1.8; }
    @media (min-width: 900px) {
        .home-page.is-stage-controlled .story-section { display: grid; align-content: center; padding-block: 1.25rem; }
        .home-page.is-stage-controlled .story-section__inner { min-height: 0; gap: 1rem; }
        .home-page.is-stage-controlled .story-book { height: clamp(280px, calc(100svh - 300px), 460px); }
    }
    @media (min-width: 721px) and (max-width: 1280px) { .story-book-shell { margin-inline: 30px; } #story-prev { left: -48px; } #story-next { right: -48px; } }
    @media (min-width: 900px) and (pointer: fine) and (max-height: 760px) {
        .home-page.is-stage-controlled .story-section__inner { gap: .65rem; }
        .home-page.is-stage-controlled .story-section__heading h2 { font-size: 1.6rem; }
        .home-page.is-stage-controlled .story-section__heading .section-copy { display: none; }
        .home-page.is-stage-controlled .story-book { padding: 1.2rem 1.6rem; }
        .home-page.is-stage-controlled #story-post-title { font-size: 2.3rem; margin-block: .6rem 1rem; padding-bottom: .7rem; }
        .home-page.is-stage-controlled #story-summary { -webkit-line-clamp: 3; font-size: .9rem; line-height: 1.7; }
        .home-page.is-stage-controlled .story-book__chapters li a { padding-block: .6rem; min-height: 44px; }
        .home-page.is-stage-controlled .story-book__actions { margin-top: .8rem; }
    }
    @media (max-width: 720px) {
        .story-section__heading { grid-template-columns: 1fr; }
        #story-tabs { justify-content: flex-start; }
        .story-selection-controls { justify-content: flex-start; gap: .35rem; }
        .story-selection-controls > button { position: static; flex-shrink: 0; }
        .story-switch-arrows { display: none; }
        #story-page { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); gap: 1.8rem; }
        .story-book { height: 760px; padding: 1.7rem 1.25rem; }
        .story-book::before { display: none; }
        .story-book::after { right: 1.25rem; }
        #story-post-title { font-size: 2rem; }
        .story-book__chapters { padding: 0; border-left: 0; }
        .story-book__chapters { border-top: 1px solid var(--line); padding-top: 1.2rem; }
        #story-summary { -webkit-line-clamp: 5; font-size: 1rem; line-height: 1.8; }
    }
    @media (prefers-reduced-motion: reduce) { :is(.story-switch-arrows, .story-selection-controls) > button { transition: none; } .story-switch-arrows button:not(:disabled):hover { transform: none; text-shadow: none; } }
</style>
