---
const schedules = [
    { id: 'con-01', name: '绒爪兽聚', location: '重庆 · 南岸区', startDate: '2026-05-02', endDate: '2026-05-04', description: '小龙第一次参加兽聚' },
    { id: 'con-02', name: '福瑞八奇物志', location: '成都 · 武侯区', startDate: '2026-07-24', endDate: '2026-07-26', description: '暑期档兽聚，会带着新装备和新物料登场（？' },
    { id: 'con-03', name: '你好兽聚HiFurry', location: '广州', startDate: '2026-10-01', endDate: '2026-10-04', description: '预计参加，目前正在准备相关的物料。' },
];

const socials = [
    { name: 'QQ', icon: 'QQ', desc: '日常交流 / 扩列', link: 'https://qm.qq.com/q/v6P80LZUdM', number: '1651388504' },
    { name: 'QQ 群', icon: 'QQ', desc: '群聊 / 交流', link: 'https://qm.qq.com/q/hrqvQDmSjK', number: '1105367000' },
    { name: 'X (Twitter)', icon: 'X', desc: '动态 / 日常', link: 'https://x.com/furrylingxun' },
    { name: 'BiliBili', icon: 'B', desc: '视频 Vlog / 短视频', link: 'https://space.bilibili.com/362846640' },
    { name: '抖音', icon: 'D', desc: '短视频 / 日常掉落', link: 'https://v.douyin.com/LsGqWRTDUKc/' },
    { name: '小红书', icon: 'R', desc: '动态 / 日常', link: 'https://www.xiaohongshu.com/user/profile/69c665ea0000000034019dd1' },
];

const socialIconPath = (icon: string, name: string) => {
    const key = `${icon} ${name}`.toLowerCase();
    if (key.includes('qq')) return '/icons/social/qq.png';
    if (key.includes('bilibili') || key.includes('b站') || key.trim() === 'b') return '/icons/social/bilibili.png';
    if (key.includes('douyin') || key.includes('抖音') || key.trim() === 'd') return '/icons/social/douyin.png';
    if (key.includes('xiaohongshu') || key.includes('小红书') || key.trim() === 'r') return '/icons/social/xiaohongshu.png';
    return '/icons/social/x.png';
};
---

<section id="final-section" class="final-section" aria-labelledby="schedule-title">
    <div class="site-container final-section__inner">
        <div class="final-section__column" data-reveal>
            <div class="eyebrow">未来行程 / On The Road</div>
            <h2 id="schedule-title" class="section-title">旅行<em>日志</em></h2>
            <p class="section-copy">行旅簿里记着已经确定的活动、地点和准备中的事情。日期状态会随着时间自动更新。</p>

            <div id="schedule-list" class="schedule-list" data-public-pending aria-busy="true">
                {schedules.map((event) => (
                    <div class="schedule-card paper-card" data-start={event.startDate} data-end={event.endDate}>
                        <div class="schedule-card__top"><span class="meta">{event.startDate} → {event.endDate}</span><span class="status-badge"></span></div>
                        <h3 class="title-text">{event.name}</h3>
                        <p class="location-text"><span aria-hidden="true">⌖</span> {event.location}</p>
                        <p class="desc-text">{event.description}</p>
                    </div>
                ))}
            </div>
        </div>

        <div class="final-section__column final-section__contact" data-reveal style="--reveal-delay: 120ms">
            <div class="eyebrow">酒馆入口 / Find Lingxun</div>
            <h2 class="section-title">想联系我？</h2>
            <p class="section-copy">如果你想找到我，不妨试试下面的工具</p>

            <div id="social-list" class="social-list" data-public-pending aria-busy="true">
                {socials.map((social) => (
                    <a href={social.link} target="_blank" rel="noopener noreferrer" class="social-card paper-card">
                        <span class={`social-card__icon social-card__icon--${social.icon.toLowerCase()}`} aria-hidden="true"><img src={socialIconPath(social.icon, social.name)} alt="" /></span>
                        <span class="social-card__body"><strong>{social.name}</strong><small>{social.desc}</small><small class="social-card__hint">打开外部页面 ↗</small>{social.number && <span class="social-card__id" data-number={social.number}>ID {social.number}</span>}</span>
                        <span class="social-card__arrow" aria-hidden="true">↗</span>
                    </a>
                ))}
            </div>

            <a href="/friends/" class="button button--accent final-section__friends">查看同行者名册 <span aria-hidden="true">→</span></a>
        </div>
    </div>

    <footer class="site-footer final-section__footer">
        <div class="site-container final-section__footer-inner">
            <span id="footer-copyright" class="meta">© {new Date().getFullYear()} LINGXUN'S TAVERN</span>
            <span id="footer-hud-feedback" class="final-section__feedback" role="status" aria-live="polite"></span>
            <div class="final-section__secret">
                <button id="entry-trigger" type="button">敲门三次</button>
                <span id="system-log-btn">酒馆暗门</span>
            </div>
        </div>
    </footer>
</section>

<script>
import { escapeHtml, fetchPublic, initPublicContent, toApiUrl, type ScheduleItem, type SocialLink } from '../lib/publicContent';
import { loadSiteContent, siteFormat, siteText } from '../lib/siteContent';

    const initFinalSection = () => {
        loadSiteContent().then(() => {
            const copyright = document.getElementById('footer-copyright');
            if (copyright) copyright.textContent = siteFormat('final.copyright', "© {year} LINGXUN'S TAVERN", { year: new Date().getFullYear() });
            applyScheduleStates();
        });
        const applyScheduleStates = () => {
            const currentDate = new Date().toISOString().split('T')[0];
            document.querySelectorAll('.schedule-card').forEach((card) => {
                const startDate = card.getAttribute('data-start');
                const endDate = card.getAttribute('data-end');
                const badge = card.querySelector('.status-badge');
                if (!startDate || !endDate || !badge) return;

                card.classList.remove('schedule-card--upcoming', 'schedule-card--ongoing', 'schedule-card--past');
                if (currentDate < startDate) {
                    card.classList.add('schedule-card--upcoming');
                    badge.textContent = siteText('final.status_upcoming', '即将出发');
                } else if (currentDate <= endDate) {
                    card.classList.add('schedule-card--ongoing');
                    badge.textContent = siteText('final.status_ongoing', '进行中');
                } else {
                    card.classList.add('schedule-card--past');
                    badge.textContent = siteText('final.status_past', '已完成');
                }
            });
        };

        const loadBackendContent = async () => {
            const [, schedules, socials] = await Promise.all([
                loadSiteContent(),
                fetchPublic<ScheduleItem[]>('/api/public/schedules'),
                fetchPublic<SocialLink[]>('/api/public/socials'),
            ]);

            const scheduleList = document.getElementById('schedule-list');
            if (scheduleList && schedules) scheduleList.innerHTML = schedules.map(renderScheduleCard).join('');

            const socialList = document.getElementById('social-list');
            if (socialList && socials) socialList.innerHTML = socials.map(renderSocialCard).join('');
            socialList?.querySelectorAll<HTMLElement>('.social-card__id').forEach(element => {
                element.textContent = siteFormat('final.number_format', 'ID {number}', { number: element.dataset.number || '' });
            });
            applyScheduleStates();
        };

        function renderScheduleCard(event: ScheduleItem) {
            return `
                <div class="schedule-card paper-card" data-start="${escapeHtml(event.start_date)}" data-end="${escapeHtml(event.end_date)}">
                    <div class="schedule-card__top"><span class="meta">${escapeHtml(event.start_date)} → ${escapeHtml(event.end_date)}</span><span class="status-badge"></span></div>
                    <h3 class="title-text">${escapeHtml(event.name)}</h3>
                    <p class="location-text"><span aria-hidden="true">⌖</span> ${escapeHtml(event.location)}</p>
                    <p class="desc-text">${escapeHtml(event.description)}</p>
                </div>
            `;
        }

        function renderSocialCard(social: SocialLink) {
            const number = social.number ? `<span class="social-card__id" data-number="${escapeHtml(social.number)}">ID ${escapeHtml(social.number)}</span>` : '';
            const icon = socialIconUrl(social.icon, social.name);
            return `
                <a href="${escapeHtml(social.link)}" target="_blank" rel="noopener noreferrer" class="social-card paper-card">
                    ${icon ? `<span class="social-card__icon" aria-hidden="true"><img src="${escapeHtml(icon)}" alt="" /></span>` : ''}
                    <span class="social-card__body"><strong>${escapeHtml(social.name)}</strong><small>${escapeHtml(social.desc)}</small><small class="social-card__hint">打开外部页面 ↗</small>${number}</span>
                    <span class="social-card__arrow" aria-hidden="true">↗</span>
                </a>
            `;
        }

        function socialIconUrl(icon: string | undefined, name: string) {
            const value = String(icon || '').trim();
            if (!value) return '';
            const preset = { QQ: 'qq', X: 'x', B: 'bilibili', D: 'douyin', R: 'xiaohongshu' }[value];
            if (preset) return `/icons/social/${preset}.png`;
            if (/^https?:\/\//i.test(value)) return value;
            if (value.startsWith('/')) return toApiUrl(value);
            const key = `${icon ?? ''} ${name}`.toLowerCase();
            if (key.includes('qq')) return '/icons/social/qq.png';
            if (key.includes('bilibili') || key.includes('b站') || key.trim() === 'b') return '/icons/social/bilibili.png';
            if (key.includes('douyin') || key.includes('抖音') || key.trim() === 'd') return '/icons/social/douyin.png';
            if (key.includes('xiaohongshu') || key.includes('小红书') || key.trim() === 'r') return '/icons/social/xiaohongshu.png';
            return '/icons/social/x.png';
        }

        applyScheduleStates();
        initPublicContent('#schedule-list, #social-list', loadBackendContent);

        const trigger = document.getElementById('entry-trigger');
        const feedback = document.getElementById('footer-hud-feedback');
        let clicks = 0;
        let lastClick = 0;
        let feedbackTimer = 0;

        const showFeedback = (message: string, tone = 'error') => {
            if (!feedback) return;
            window.clearTimeout(feedbackTimer);
            feedback.textContent = message;
            feedback.dataset.tone = tone;
            feedback.classList.add('is-visible');
            feedbackTimer = window.setTimeout(() => feedback.classList.remove('is-visible'), 1800);
        };

        trigger?.addEventListener('click', () => {
            const now = Date.now();
            if (now - lastClick > 1200) clicks = 0;
            clicks += 1;
            lastClick = now;

            if (clicks === 1) showFeedback(siteText('final.knock_first', '还差两下，听见了吗？'));
            else if (clicks === 2) showFeedback(siteText('final.knock_second', '门后的灯亮了一盏。'), 'warn');
            else {
                clicks = 0;
                showFeedback(siteText('final.knock_open', '暗门已开，欢迎进来。'), 'success');
                const eggSection = document.getElementById('easter-egg-section');
                eggSection?.classList.remove('hidden', 'is-closing');
                eggSection?.setAttribute('aria-hidden', 'false');
                window.requestAnimationFrame(() => {
                    eggSection?.classList.add('is-open');
                    eggSection?.dispatchEvent(new CustomEvent('lingxun:egg-open'));
                });
                window.setTimeout(() => eggSection?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
            }
        });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initFinalSection, { once: true });
    else initFinalSection();
</script>

<style is:global>
    .final-section { background: var(--ink-blue); color: var(--paper); }
    .final-section__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(3.5rem, 8vw, 8rem); padding-block: clamp(5rem, 12vw, 10rem); }
    .final-section__column { min-width: 0; }
    .schedule-list, .social-list { display: grid; gap: 0.8rem; margin-top: 2rem; }
    .schedule-card { padding: 1.25rem; }
    .schedule-card__top { display: flex; justify-content: space-between; align-items: start; gap: 1rem; }
    .schedule-card h3 { margin: 1rem 0 0.25rem; color: var(--paper); font-family: var(--font-serif); font-size: 1.35rem; }
    .schedule-card p { margin: 0; }
    .schedule-card .location-text { color: var(--steel-soft); font-size: 0.9rem; }
    .schedule-card .desc-text { margin-top: 0.55rem; color: var(--paper-muted); font-size: 0.9rem; }
    .status-badge { display: inline-flex; min-height: 26px; align-items: center; padding: 0.15rem 0.45rem; border: 1px solid currentColor; font-family: var(--font-mono); font-size: 0.66rem; white-space: nowrap; }
    .schedule-card--upcoming { border-color: rgba(241, 240, 235, 0.32); }
    .schedule-card--upcoming .status-badge { color: var(--paper-muted); }
    .schedule-card--ongoing { border-color: var(--gold); background: rgba(211, 168, 61, 0.08); }
    .schedule-card--ongoing .status-badge { color: var(--gold); }
    .schedule-card--past { filter: saturate(0.4); }
    .schedule-card--past .status-badge { color: var(--steel-soft); }
    .social-card { display: flex; align-items: center; gap: 0.9rem; padding: 0.8rem; }
    .social-card__icon { display: inline-grid; place-items: center; flex: 0 0 2.75rem; width: 2.75rem; height: 2.75rem; overflow: visible; border: 0; background: transparent; }
    .social-card__icon img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .social-card__icon--qq { border-color: #2f8cff; color: #2f8cff; }
    .social-card__icon--x { border-color: var(--paper); color: var(--paper); font-family: var(--font-sans); }
    .social-card__icon--b, .social-card__icon--bilibili { border-color: #00aeec; color: #00aeec; }
    .social-card__icon--d { border-color: #e93355; color: #e93355; }
    .social-card__icon--r { border-color: #ff2442; color: #ff2442; }
    .social-card__body { display: grid; min-width: 0; flex: 1; }
    .social-card__body strong { color: var(--paper); font-family: var(--font-serif); font-size: 1.05rem; }
    .social-card__body small { overflow: hidden; color: var(--steel-soft); text-overflow: ellipsis; white-space: nowrap; }
    .social-card__body .social-card__hint { color: var(--gold); font-size: 0.72rem; }
    .social-card__id { margin-top: 0.15rem; color: var(--gold); font-family: var(--font-mono); font-size: 0.7rem; }
    .social-card__arrow { color: var(--steel-soft); font-size: 1.2rem; transition: color 180ms ease, transform 180ms ease; }
    .social-card:hover .social-card__arrow { color: var(--gold); transform: translate(2px, -2px); }
    .final-section__friends { width: 100%; margin-top: 1rem; }
    .final-section__footer { padding-block: 1rem; }
    .final-section__footer-inner { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 58px; }
    .final-section__secret { display: flex; align-items: center; gap: 1rem; color: var(--steel-soft); font-size: 0.8rem; }
    .final-section__secret button { min-height: 44px; padding: 0.4rem 0; border: 0; background: transparent; color: var(--gold); cursor: pointer; }
    .final-section__secret span { color: var(--steel-soft); }
    .final-section__feedback { position: absolute; right: 8rem; bottom: 3.8rem; max-width: min(22rem, calc(100vw - 2rem)); color: var(--red-soft); opacity: 0; transform: translateY(0.4rem); transition: opacity 180ms ease, transform 180ms ease; }
    .final-section__feedback.is-visible { opacity: 1; transform: translateY(0); }
    .final-section__feedback[data-tone="warn"] { color: var(--gold); }
    .final-section__feedback[data-tone="success"] { color: #9ec5a8; }

    @media (min-width: 900px) {
        .final-section__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); }
        .social-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; margin-top: 1.5rem; }
        .social-card { gap: 0.65rem; min-height: 5rem; padding: 0.65rem; }
        .social-card__icon { flex-basis: 2.25rem; width: 2.25rem; height: 2.25rem; }
        .social-card__body strong { font-size: 0.98rem; }
        .social-card__body .social-card__hint { font-size: 0.65rem; }
        .social-card__id { font-size: 0.64rem; }
        .social-card__arrow { font-size: 1rem; }
    }

    @media (max-width: 520px) {
        .final-section__footer-inner { align-items: flex-start; flex-direction: column; padding-block: 0.8rem; }
        .final-section__feedback { right: auto; bottom: 4.7rem; left: 0; }
    }
</style>
