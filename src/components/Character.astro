---
import SceneOrnament from './SceneOrnament.astro';
import '../styles/record-switch.css';
---
<section id="character-section" class="character-section" aria-labelledby="character-title" data-public-pending aria-busy="true">
    <SceneOrnament kind="book" />
    <div class="character-diagonal" aria-hidden="true"></div>
    <figure class="character-visual"><div class="character-visual__entry" data-reveal style="--reveal-delay: 110ms"><div id="character-visual-content" class="character-visual__content"></div></div></figure>
    <div class="site-container character-section__inner">
        <header class="character-selection" data-reveal><div class="eyebrow">角色介绍</div><span class="meta">CHARACTERS</span></header>
        <nav class="character-roster" aria-label="角色切换" data-reveal style="--reveal-delay: 240ms">
            <button id="character-prev" type="button" aria-label="上一个角色" title="上一个角色">↖</button>
            <div id="character-tabs" class="record-tabs" aria-label="选择角色"></div>
            <button id="character-next" type="button" aria-label="下一个角色" title="下一个角色">↘</button>
        </nav>
        <div class="character-stage" data-reveal style="--reveal-delay: 110ms"><article id="character-profile" role="tabpanel" tabindex="0"></article></div>
    </div>
</section>
<script>
    import { escapeHtml, fetchRequired, initPublicContent, setImageSource, type CharacterProfile } from '../lib/publicContent';
    import { loadSiteContent, resolveSiteImage, siteText } from '../lib/siteContent';
    import { characterChoice, recordTabs, recordTransition } from '../lib/recordSwitch';
    initPublicContent('#character-section', async () => {
        const [characters] = await Promise.all([fetchRequired<CharacterProfile[]>('/api/public/characters'), loadSiteContent()]);
        const profile = document.getElementById('character-profile')!, visual = document.getElementById('character-visual-content')!;
        if (!characters.length) { document.getElementById('character-section')!.hidden = true; return; }
        let activate: (index: number) => void, current = 0;
        const portraits = new Map<number, Promise<HTMLElement>>();
        const prepare = (index: number) => {
            if (!portraits.has(index)) portraits.set(index, (async () => {
                const item = characters[index], url = resolveSiteImage(item.image_url || '');
                const content = document.createElement('div'); content.className = 'character-visual__frame';
                const placeholder = (message: string) => { content.innerHTML = `<div class="dossier-portrait__empty"><span>${escapeHtml(item.alias || item.name)}</span><strong>${escapeHtml(item.name)}</strong><small>${escapeHtml(message)}</small></div>`; };
                if (!url) { placeholder(siteText('character.no_photo', '暂未放入角色照片')); return content; }
                const image = new Image(); image.alt = `${item.name}的角色照片`; image.decoding = 'async';
                setImageSource(image, url, item.image, '(min-width: 900px) 55vw, 90vw');
                let timer: ReturnType<typeof setTimeout> | undefined;
                try {
                    await Promise.race([image.decode(), new Promise((_, reject) => { timer = setTimeout(() => reject(new Error('image timeout')), 8000); })]);
                    const caption = document.createElement('figcaption'); caption.textContent = `${item.name} / 影像资料`;
                    content.append(image, caption);
                } catch { placeholder(siteText('character.image_error', '角色照片暂时无法打开')); }
                finally { clearTimeout(timer); }
                return content;
            })());
            return portraits.get(index)!;
        };
        let portrait: HTMLElement;
        const prepareChange = async (index: number) => { portrait = await prepare(index); };
        const render = (index: number) => {
            current = index;
            const item = characters[index];
            const facts = [['species', '物种', item.species], ['role', '职业', item.role], ['region', '活动区域', item.region], ['work', '主要工作', item.work], ['places', '常去地点', item.places], ['status', '当前状态', item.status]]
                .filter(([, , value]) => value?.trim()).map(([key, label, value]) => `<div data-field="${key}"><dt>${escapeHtml(siteText(`character.field_${key}`, label))}</dt><dd>${escapeHtml(value)}</dd></div>`).join('');
            const custom = (item.custom_fields || []).filter(field => field.label?.trim() && field.value?.trim()).map(field => `<div><dt>${escapeHtml(field.label)}</dt><dd>${escapeHtml(field.value)}</dd></div>`).join('');
            const paragraphs = (item.details || '').split(/\n{2,}/).filter(Boolean).map(paragraph => `<p>${escapeHtml(paragraph).replaceAll('\n', '<br>')}</p>`).join('');
            profile.innerHTML = `<header class="dossier-heading"><h2 id="character-title">${escapeHtml(item.name)}<em>${escapeHtml(item.alias || '')}</em></h2>${item.introduction ? `<p class="dossier-lead">${escapeHtml(item.introduction)}</p>` : ''}</header><dl class="dossier-facts">${facts}${custom}</dl>${paragraphs ? `<div class="dossier-notes">${paragraphs}</div>` : ''}`;
            visual.replaceChildren(portrait);
            profile.setAttribute('aria-labelledby', `character-profile-tab-${index}`); activate?.(index);
        };
        const change = recordTransition([profile, visual], render, { diagonal: true, prepare: prepareChange, resize: document.querySelector<HTMLElement>('.character-stage')! });
        const tabs = document.getElementById('character-tabs')!;
        activate = recordTabs(tabs, characters.map(item => characterChoice(item, item.alias)), 'character-profile', index => void change(index));
        const roster = document.querySelector<HTMLElement>('.character-roster')!;
        const positionRoster = () => {
            const section = document.getElementById('character-section')!;
            const slope = section.clientWidth * .198 / section.clientHeight;
            const centerY = roster.offsetHeight / 2;
            roster.querySelectorAll<HTMLElement>(':scope > button, .record-tab').forEach(button => {
                const y = button.offsetTop + (button.parentElement === tabs ? tabs.offsetTop : 0) + button.offsetHeight / 2;
                button.style.setProperty('--roster-shift', `${(y - centerY) * slope}px`);
            });
        };
        new ResizeObserver(positionRoster).observe(document.getElementById('character-section')!);
        new ResizeObserver(positionRoster).observe(roster);
        const previous = document.getElementById('character-prev') as HTMLButtonElement, next = document.getElementById('character-next') as HTMLButtonElement;
        previous.disabled = next.disabled = characters.length < 2;
        previous.addEventListener('click', () => void change((current - 1 + characters.length) % characters.length, -1));
        next.addEventListener('click', () => void change((current + 1) % characters.length, 1));
        await prepareChange(0);
        render(0);
    });
</script>
<style is:global>
    #character-section[hidden] { display: none; }
    .character-section { position: relative; isolation: isolate; padding-block: 3rem; border-top: 1px solid var(--line); background-color: var(--ink-soft); overflow: clip; overflow-anchor: none; }
    .character-section::before { display: block; mask-position: center center; }
    .character-section .character-section__inner { display: grid; gap: 1.5rem; }
    .character-selection { display: flex; gap: 1.5rem; align-items: baseline; }
    .character-selection .eyebrow { font: 700 .85rem/1.5 var(--font-sans); color: var(--gold); letter-spacing: 0; }
    .character-selection .eyebrow::before { width: 28px; background: var(--red-soft); }
    .character-selection > .meta { color: var(--steel-soft); font-size: .65rem; }
    .character-visual { min-width: 0; margin: 0; background: var(--surface-card); position: relative; overflow: hidden; }
    .character-visual__entry, .character-visual__content, .character-visual__frame { width: 100%; height: 100%; }
    .character-visual img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .character-visual figcaption { position: absolute; bottom: 1rem; right: 1rem; padding: .4rem .7rem; background: #0b0d10c9; color: #f1f0eb; font-size: .7rem; }
    .dossier-portrait__empty { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 2rem; background: var(--surface-paper) url('/images/decor/paper-grain.svg'); text-align: center; color: var(--steel-soft); }
    .dossier-portrait__empty span { font: italic 3.4rem var(--font-display); }
    .dossier-portrait__empty strong { font: 500 2rem var(--font-serif); color: var(--paper-muted); }
    .dossier-portrait__empty small { font-size: .8rem; }
    .character-roster { min-width: 0; }
    .character-roster > button { display: grid; place-items: center; width: 44px; height: 44px; background: transparent; border: 0; color: var(--gold); font: 2rem var(--font-sans); cursor: pointer; }
    .character-roster > button:focus-visible { outline: 2px solid var(--gold); border-radius: var(--radius-control); }
    .character-roster > button:disabled { opacity: .4; }
    .character-roster > button { transition: transform .2s, color .2s; }
    @media (hover: hover) { .character-roster > button:not(:disabled):hover { transform: translateY(-3px); color: color-mix(in srgb, var(--gold) 65%, var(--paper)); } }
    #character-profile, .character-stage { min-width: 0; }
    .dossier-heading h2 { margin: 0; font: 700 3.8rem/1.2 var(--font-serif); overflow-wrap: anywhere; }
    .dossier-heading h2 em { display: block; margin-top: .35rem; color: var(--red-soft); font: italic 600 2.1rem/1.2 var(--font-display); }
    .dossier-lead { margin: 1.25rem 0 0; color: var(--paper-muted); font: 400 1rem/1.85 var(--font-sans); }
    .dossier-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem 1.5rem; margin: 1.25rem 0 0; }
    .dossier-facts div { border-left: 2px solid var(--line); padding-left: .8rem; }
    .dossier-facts dt { color: var(--steel-soft); font-size: .78rem; }
    .dossier-facts dd { margin: .3rem 0 0; font: 700 1rem/1.6 var(--font-sans); overflow-wrap: anywhere; }
    .dossier-facts [data-field='species'], .dossier-facts [data-field='role'] { border-color: var(--gold); }
    .dossier-facts [data-field='status'] dd { color: var(--red-soft); }
    .dossier-notes { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--line-soft); color: var(--paper-muted); font-size: 1rem; line-height: 1.85; }
    .dossier-notes p { margin: 0 0 .5rem; }
    .dossier-notes p:last-child { margin-bottom: 0; }
    @media (min-width: 900px) {
        .character-section .character-section__inner { position: static; }
        .character-visual { position: absolute; inset: 0 0 0 auto; width: 52%; clip-path: polygon(0 0, 100% 0, 100% 100%, 38% 100%); z-index: 0; }
        .character-visual .dossier-portrait__empty { padding-left: 35%; }
        .character-diagonal { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: var(--gold); opacity: .55; clip-path: polygon(47.9% 0, 48.05% 0, 67.85% 100%, 67.7% 100%); }
        .character-stage, .character-selection { position: relative; z-index: 1; width: 45%; }
        .character-section .character-section__inner { min-height: 650px; grid-template-rows: auto auto; align-content: center; }
        .character-stage { height: auto; overflow: visible; }
        .character-roster { position: absolute; top: 50%; left: calc(57.9% - 107px); translate: 0 -50%; z-index: 2; display: grid; justify-items: center; }
        #character-tabs { position: relative; display: grid; gap: .7rem; }
        #character-tabs .record-tab, .character-roster > button { translate: var(--roster-shift, 0px) 0; }
        .home-page.is-stage-controlled .character-section .character-section__inner { height: min(760px, calc(100svh - 76px - clamp(4rem, 10svh, 8rem))); min-height: 0; grid-template-rows: auto minmax(0, 1fr); max-height: 100%; overflow: visible; gap: 1.5rem; }
        .home-page.is-stage-controlled .character-stage { display: grid; align-content: safe center; height: 100%; min-height: 0; overflow-x: clip; overflow-y: auto; overscroll-behavior-y: auto; scrollbar-width: thin; }
        .home-page.is-stage-controlled .character-section { padding-block: clamp(2rem, 5svh, 4rem); }
    }
    @media (min-width: 900px) and (pointer: fine) and (max-height: 740px) {
        .home-page.is-stage-controlled .character-section .character-section__inner { gap: .7rem; }
        .dossier-heading h2 { font-size: 2.7rem; } .dossier-heading h2 em { font-size: 1.7rem; }
        .dossier-lead { margin-top: .7rem; font-size: .95rem; line-height: 1.65; }
        .dossier-facts { margin-top: .8rem; gap: .55rem 1rem; } .dossier-facts dd { font-size: .9rem; line-height: 1.45; }
        .dossier-notes { margin-top: .7rem; padding-top: .7rem; font-size: .9rem; line-height: 1.7; }
    }
    @media (max-width: 899px) {
        .character-stage { overflow: clip; }
        .character-visual { height: 290px; border-block: 1px solid var(--line); margin: 1.5rem var(--space-page); }
        .character-diagonal { display: none; }
        .character-roster { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
        #character-tabs { display: flex; flex: 1; justify-content: center; gap: .5rem; }
        .character-roster > button { flex: 0 0 44px; }
        .dossier-heading h2 { font-size: 3rem; } .dossier-heading h2 em { display: inline; margin-left: 1rem; font-size: 1.9rem; }
    }
    @media (min-width: 900px) and (pointer: coarse) {
        .character-section .character-section__inner { min-height: 0; }
        .character-stage { max-height: none; overflow: visible; overscroll-behavior-y: auto; }
    }
    @media (prefers-reduced-motion: reduce) { .character-roster > button { transition: none; } .character-roster > button:not(:disabled):hover { transform: none; } }
</style>
