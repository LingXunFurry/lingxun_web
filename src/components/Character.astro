---
import { Image } from "astro:assets";
import characterPhoto from "../assets/gallery/photo3.webp";
---

<section
  id="character-section"
  class="character-section"
  aria-labelledby="character-title"
  data-public-pending
  aria-busy="true"
>
  <div class="site-container character-section__inner">
    <div class="character-section__photo paper-card" data-reveal>
      <div class="character-section__photo-label meta">
        FIELD RECORD / 城镇实拍
      </div>
      <Image
        id="character-image"
        src={characterPhoto}
        alt="凌巽在城镇绿荫间的毛毛实拍照片"
        class="character-section__image"
        data-default-src={characterPhoto.src}
        loading="lazy"
        decoding="async"
      />
      <p id="character-image-state" class="character-section__image-state" role="status" hidden></p>
      <div class="character-section__photo-caption">
        <span>同行记录 · 03</span>
        <span class="meta">城镇生活</span>
      </div>
    </div>

    <div
      id="character-profile"
      class="character-section__copy"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      <div class="eyebrow">冒险者登记簿 / Current Record</div>
      <div class="character-section__heading">
        <h2 id="character-title" class="section-title">
          凌巽 <em>Lingxun</em>
        </h2><div
          id="character-switcher"
          class="character-section__switcher hidden"
        >
          <button
            id="character-prev"
            type="button"
            aria-label="查看上一位登记角色">←</button
          ><span id="character-position" class="meta">01 / 01</span><button
            id="character-next"
            type="button"
            aria-label="查看下一位登记角色">→</button>
        </div>
      </div>
      <p class="character-section__role">
        一条住在人类城镇里的龙，接公会委托谋生，平时喜欢在家读魔法书。
      </p>
      <div class="character-section__text">
        <p>
          凌巽是一条风龙，职业是法师，同时也擅长使用各种武器战斗
        </p>
        <p>
          他穿着适合人类城镇生活的冒险者服装，做事可靠，习惯先观察再行动。委托结束后，最常去的地方是公会、酒馆或是自己的小家。
        </p>
      </div>

      <dl class="character-section__facts">
        <div><dt>姓名</dt><dd>凌巽 Lingxun</dd></div>
        <div><dt>种族</dt><dd>风龙</dd></div>
        <div><dt>身份</dt><dd>法师 / 冒险者</dd></div>
        <div><dt>活动区域</dt><dd>人类城镇</dd></div>
        <div><dt>主要工作</dt><dd>冒险者公会委托</dd></div>
        <div><dt>常去地点</dt><dd>公会 / 酒馆 / 家中</dd></div>
        <div>
          <dt>当前状态</dt><dd class="character-section__status">可接受委托</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<script>
  import {
    escapeHtml,
    fetchPublic,
    initPublicContent,
    type CharacterProfile,
  } from "../lib/publicContent";
  import { loadSiteContent, resolveSiteImage, siteText } from "../lib/siteContent";

  const initCharacterRegistry = async () => {
    const profile = document.getElementById("character-profile");
    const image = document.getElementById(
      "character-image",
    ) as HTMLImageElement | null;
    const characters = await fetchPublic<CharacterProfile[]>(
      "/api/public/characters",
    );
    if (!profile || !characters) return;
    if (!characters.length) {
      const section = document.getElementById('character-section');
      section?.classList.add('hidden');
      section?.setAttribute('hidden', '');
      return;
    }
    await loadSiteContent();
    let current = 0;

    const render = () => {
      const item = characters[current];
      const details = item.details?.trim() || '';
      const detailHtml = details.split(/\n{2,}/).map((paragraph) => `<p>${escapeHtml(paragraph).replaceAll("\n", "<br>")}</p>`).join("");
      const customFields = (item.custom_fields || []).filter((field) => field.label?.trim() && field.value?.trim());
      const customFacts = customFields.map((field) => `<div><dt>${escapeHtml(field.label)}</dt><dd>${escapeHtml(field.value)}</dd></div>`).join("");
      const facts = [
        ['name', '姓名', `${item.name} ${item.alias || ''}`],
        ['species', '种族', item.species], ['role', '身份', item.role],
        ['region', '活动区域', item.region], ['work', '主要工作', item.work],
        ['places', '常去地点', item.places], ['status', '当前状态', item.status],
      ].filter(([, , value]) => value?.trim()).map(([key, label, value]) =>
        `<div><dt>${escapeHtml(siteText(`character.field_${key}`, label))}</dt><dd${key === 'status' ? ' class="character-section__status"' : ''}>${escapeHtml(value)}</dd></div>`,
      ).join('');
      profile.innerHTML = `
                <div class="eyebrow">冒险者登记簿 / Current Record</div>
                <div class="character-section__heading"><h2 id="character-title" class="section-title">${escapeHtml(item.name)} <em>${escapeHtml(item.alias || "")}</em></h2><div class="character-section__switcher"><button id="character-prev" type="button" aria-label="查看上一位登记角色">←</button><span class="meta">${String(current + 1).padStart(2, "0")} / ${String(characters.length).padStart(2, "0")}</span><button id="character-next" type="button" aria-label="查看下一位登记角色">→</button></div></div>
                ${item.introduction ? `<p class="character-section__role">${escapeHtml(item.introduction)}</p>` : ''}
                ${details ? `<div class="character-section__text">${detailHtml}</div>` : ''}
                <dl class="character-section__facts">${facts}${customFacts}</dl>`;
      if (image) {
        const url = resolveSiteImage(item.image_url || '');
        const status = document.getElementById('character-image-state');
        image.removeAttribute('srcset');
        image.hidden = !url;
        if (status) { status.hidden = Boolean(url); status.textContent = siteText('character.no_photo', '暂未放入登记照片'); }
        image.onerror = () => {
          image.hidden = true;
          if (status) { status.hidden = false; status.textContent = siteText('character.image_error', '登记照片暂时无法打开'); }
        };
        if (url) image.src = url;
        else image.removeAttribute('src');
        image.alt = `${item.name} 登记照片`;
      }
      const switcher = profile.querySelector<HTMLElement>('.character-section__switcher');
      if (switcher) switcher.hidden = characters.length < 2;
      profile
        .querySelector("#character-prev")
        ?.addEventListener("click", () => {
          current = (current - 1 + characters.length) % characters.length;
          render();
        });
      profile
        .querySelector("#character-next")
        ?.addEventListener("click", () => {
          current = (current + 1) % characters.length;
          render();
        });
    };
    render();
  };
  initPublicContent('#character-section', initCharacterRegistry);
</script>

<style is:global>
  #character-section[hidden], #character-image[hidden], #character-image-state[hidden], .character-section__switcher[hidden] { display: none; }
  .character-section__image-state { display: grid; place-items: center; min-height: 15rem; margin: 0; padding: 2rem; border: 1px dashed var(--line); color: var(--paper-muted); text-align: center; }
  .character-section {
    padding-block: clamp(5rem, 12vw, 10rem);
    background: var(--ink-soft);
    border-top: 1px solid var(--line-soft);
  }

  .character-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }

  .character-section__photo {
    width: min(100%, 31rem);
    margin-inline: auto;
    padding: 0.7rem;
    background: var(--surface-paper);
    box-shadow: var(--shadow-paper);
    transform: rotate(-1.5deg);
  }

  .character-section__photo-label,
  .character-section__photo-caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0.2rem 0.65rem;
  }

  .character-section__photo-caption {
    padding: 0.65rem 0.2rem 0.15rem;
    color: var(--paper-muted);
    font-size: 0.78rem;
  }

  .character-section__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.7) contrast(1.08);
  }

  .character-section__copy {
    max-width: 42rem;
  }
  .character-section__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .character-section__heading .section-title {
    min-width: 0;
    overflow-wrap: anywhere;
    flex: 1 1 16rem;
  }
  .character-section__switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 auto;
  }
  .character-section__switcher button {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--paper);
    cursor: pointer;
  }
  .character-section__switcher button:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .character-section__role {
    margin: 1.35rem 0 0;
    color: var(--red-soft);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 1.85rem);
    line-height: 1.45;
  }
  .character-section__text {
    margin-top: 1.5rem;
    color: var(--paper-muted);
    line-height: 1.9;
  }
  .character-section__text p {
    margin: 0 0 1rem;
  }

  .character-section__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 2rem 0 0;
    border-top: 1px solid var(--line);
  }

  .character-section__facts div {
    padding: 0.95rem 0.8rem 0.95rem 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .character-section__facts dt {
    color: var(--steel-soft);
    font-size: 0.75rem;
  }
  .character-section__facts dd {
    margin: 0.2rem 0 0;
    color: var(--paper);
    font-family: var(--font-serif);
    font-weight: 700;
  }
  .character-section__status {
    color: var(--gold) !important;
  }

  @media (min-width: 860px) {
    .character-section__inner {
      grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    }
  }

  @media (max-width: 540px) {
    .character-section__heading {
      flex-direction: column;
      align-items: flex-start;
    }
    .character-section__heading .section-title {
      flex: auto;
      max-width: 100%;
    }
    .character-section__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
