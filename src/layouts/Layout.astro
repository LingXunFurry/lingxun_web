---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'

const { title = '凌巽的酒馆', titleKey = '' } = Astro.props;
---

<!doctype html>
<html lang="zh" class="scroll-smooth" data-api-base={import.meta.env.PUBLIC_API_BASE ?? ''}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link id="site-favicon" rel="icon" href="/logo.png" />
        <meta name="generator" content={Astro.generator} />
        <title data-content-title={titleKey}>{title}</title>
        <script is:inline>
            (() => {
                const saved = localStorage.getItem('lingxun-theme');
                const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
                document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : preferred;
            })();
        </script>

        <meta name="description" content="欢迎来到凌巽的个人网站,这里展示了我的设定背景,日常动态还有精美照片,以及更多未发现的东西?">
    </head>
    <body>
        <Navbar />

        <slot />

        <script>
            import { initSiteContent } from '../lib/siteContent';
            initSiteContent();
            document.documentElement.classList.add('reveal-ready');
            const revealItems = document.querySelectorAll('[data-reveal]');
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (reducedMotion || typeof IntersectionObserver === 'undefined') {
                revealItems.forEach((item) => item.classList.add('is-visible'));
            } else {
                const revealObserver = new IntersectionObserver((entries, observer) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    });
                }, { threshold: 0.01, rootMargin: '0px 0px -8% 0px' });

                revealItems.forEach((item) => revealObserver.observe(item));
            }
        </script>
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        /* 【核心修复点】去掉死板的 height: 100%，改为最低高度满屏，允许无限向下生长 */
        min-height: 100vh;
        /* 隐藏左右方向的滚动条，防止有些特效溢出导致页面能左右晃动 */
        overflow-x: hidden;
    }
    
    body {
        /* 强制让内部内容自然溢出给浏览器接管，杜绝内层双滚动条 */
        overflow-y: visible;
    }
</style>
