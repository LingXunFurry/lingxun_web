---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import settingOne from '../assets/setting/Image_1774261272205_454.png';
import settingTwo from '../assets/setting/Image_1777968000555_846.png';
import { galleryCategories, galleryPhotos } from '../data/photos';

const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{jpeg,jpg,png,PNG,webp}', { eager: true });
const settingImages: Record<string, ImageMetadata> = {
    'Image_1774261272205_454.png': settingOne,
    'Image_1777968000555_846.png': settingTwo,
};
const localEntries = galleryPhotos.flatMap((meta) => {
    const image = settingImages[meta.src] ?? localImages[`/src/assets/gallery/${meta.src}`]?.default;
    return image ? [{ ...meta, image }] : [];
});
const filters = [...galleryCategories, '后台档案'];
---

<Layout title="旅途留影 | 凌巽的酒馆" titleKey="site.gallery_title">
    <main class="gallery-page" aria-labelledby="gallery-title">
        <header class="site-container gallery-page__header" data-reveal>
            <div class="eyebrow">旅途留影 / Visual Archive</div>
            <div class="gallery-page__heading">
                <div>
                    <h1 id="gallery-title" class="section-title">照片墙上的<em>旅途</em></h1>
                    <p class="section-copy">这里保存实拍、活动记录、装备和设定档案。选择一个类别，或打开照片查看完整记录。</p>
                </div>
                <div class="gallery-page__index"><span class="meta">ARCHIVE</span><strong id="gallery-count">{localEntries.length}</strong><span class="meta">张记录</span></div>
            </div>
        </header>

        <div class="site-container gallery-page__filters" data-reveal style="--reveal-delay: 100ms">
            <div class="gallery-filter-list" role="group" aria-label="画廊类别筛选">
                {filters.map((filter) => (
                    <button type="button" class={`gallery-filter ${filter === '全部' ? 'is-active' : ''}`} data-filter={filter} aria-pressed={filter === '全部'}>{filter}</button>
                ))}
            </div>
            <div id="gallery-character-filters" class="gallery-character-filters hidden" role="group" aria-label="按角色筛选"></div>
        </div>

        <section class="site-container gallery-page__content" aria-live="polite">
            <div id="gallery-grid" class="gallery-grid" data-reveal style="--reveal-delay: 160ms">
                {localEntries.map((entry, index) => (
                    <article class="gallery-card paper-card" data-gallery-item data-index={index} data-category={entry.category} data-character-ids={(entry.character_ids ?? []).join(',')} data-src={entry.image.src} data-title={entry.title} data-date={entry.date ?? ''} data-location={entry.location ?? ''} data-description={entry.description ?? ''}>
                        <button type="button" class="gallery-card__button" data-gallery-trigger data-index={index} aria-label={`打开${entry.title}`}>
                            <Image src={entry.image} alt={entry.title} loading="lazy" decoding="async" />
                            <span class="gallery-card__open" aria-hidden="true">打开记录 ↗</span>
                        </button>
                        <div class="gallery-card__details">
                            <div class="gallery-card__line"><span class="tag">{entry.category}</span><span class="meta">{String(index + 1).padStart(2, '0')}</span></div>
                            <h2>{entry.title}</h2>
                            <p>{entry.location ?? '凌巽的旅途'}</p>
                        </div>
                    </article>
                ))}
            </div>
            <div id="gallery-loading" class="gallery-state hidden">正在整理照片……</div>
            <div id="gallery-empty" class="gallery-state hidden">这个分类暂时没有照片记录。</div>
        </section>

        <div class="site-container gallery-page__footer" data-reveal style="--reveal-delay: 220ms">
            <a href="/" class="button button--quiet"><span aria-hidden="true">←</span> 返回酒馆入口</a>
            <span class="meta">PHOTO WALL / 旅途档案持续整理</span>
        </div>
    </main>

    <div id="lightbox-modal" class="lightbox-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true">
        <div class="lightbox-modal__backdrop" data-modal-close></div>
        <div class="lightbox-modal__panel">
            <div class="lightbox-modal__toolbar">
                <div><span class="meta">PHOTO RECORD</span><span id="modal-position" class="lightbox-modal__position">01 / 01</span></div>
                <div class="lightbox-modal__actions">
                    <button id="modal-download" class="button button--accent" type="button">保存 <span aria-hidden="true">↓</span></button>
                    <button id="modal-zoom" class="button" type="button" aria-pressed="false">缩放</button>
                    <button id="modal-close" class="button" type="button" aria-label="关闭照片详情">关闭 <span aria-hidden="true">×</span></button>
                </div>
            </div>
            <div class="lightbox-modal__body">
                <button id="modal-prev" class="lightbox-modal__nav" type="button" aria-label="上一张照片">←</button>
                <div class="lightbox-modal__stage">
                    <div id="modal-status" class="lightbox-modal__status" role="status">正在加载照片……</div>
                    <img id="modal-img" src="" alt="" />
                </div>
                <button id="modal-next" class="lightbox-modal__nav" type="button" aria-label="下一张照片">→</button>
            </div>
            <div class="lightbox-modal__info">
                <div><span id="modal-category" class="tag"></span><h2 id="modal-title"></h2><p id="modal-description"></p></div>
                <dl><div><dt>日期</dt><dd id="modal-date">-</dd></div><div><dt>地点</dt><dd id="modal-location">-</dd></div></dl>
            </div>
            <div id="modal-thumbs" class="lightbox-modal__thumbs" aria-label="照片缩略图导航"></div>
        </div>
    </div>
</Layout>

<script>
    import { escapeHtml, fetchPublic, toApiUrl, type CharacterProfile, type GalleryPhoto } from '../lib/publicContent';
    import { loadSiteContent, siteText, siteFormat } from '../lib/siteContent';

    const initGalleryPage = async () => {
        const grid = document.getElementById('gallery-grid');
        const modal = document.getElementById('lightbox-modal');
        const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
        const modalStatus = document.getElementById('modal-status');
        const modalTitle = document.getElementById('modal-title');
        const modalCategory = document.getElementById('modal-category');
        const modalDescription = document.getElementById('modal-description');
        const modalDate = document.getElementById('modal-date');
        const modalLocation = document.getElementById('modal-location');
        const modalPosition = document.getElementById('modal-position');
        const modalThumbs = document.getElementById('modal-thumbs');
        const count = document.getElementById('gallery-count');
        const empty = document.getElementById('gallery-empty');
        const zoomButton = document.getElementById('modal-zoom');
        const downloadButton = document.getElementById('modal-download');
        const closeButton = document.getElementById('modal-close');
        const previousButton = document.getElementById('modal-prev');
        const nextButton = document.getElementById('modal-next');
        if (!grid || !modal || !modalImg) return;

        const state: { items: GalleryItem[]; visible: GalleryItem[]; current: number; filter: string; characterFilter: number[]; lastTrigger: HTMLElement | null } = {
            items: readLocalItems(), visible: [], current: 0, filter: '全部', characterFilter: [], lastTrigger: null,
        };

        type GalleryItem = { src: string; title: string; category: string; date: string; location: string; description: string; character_ids: number[] };

        function readLocalItems(): GalleryItem[] {
            return Array.from(grid.querySelectorAll<HTMLElement>('[data-gallery-item]')).map((item) => ({
                src: item.dataset.src || '', title: item.dataset.title || '旅途留影', category: item.dataset.category || '未分类', date: item.dataset.date || '', location: item.dataset.location || '', description: item.dataset.description || '', character_ids: (item.dataset.characterIds || '').split(',').map(Number).filter(Boolean),
            })).filter((item) => item.src);
        }

        function renderGrid() {
            state.visible = state.items.map((item, index) => ({ ...item, _index: index } as GalleryItem & { _index: number })).filter((item) => (state.filter === '全部' || item.category === state.filter) && (!state.characterFilter.length || state.characterFilter.some((id) => item.character_ids.includes(id))));
            grid.innerHTML = state.visible.map((item) => `
                <article class="gallery-card paper-card" data-gallery-item data-index="${item._index}">
                    <button type="button" class="gallery-card__button" data-gallery-trigger data-index="${item._index}" aria-label="${escapeHtml(siteFormat('gallery.open_label', '打开{title}', { title: item.title }))}">
                        <img src="${escapeHtml(item.src)}" alt="${escapeHtml(item.title)}" loading="lazy" decoding="async" />
                        <span class="gallery-card__open" aria-hidden="true">打开记录 ↗</span>
                    </button>
                    <div class="gallery-card__details"><div class="gallery-card__line"><span class="tag">${escapeHtml(item.category)}</span><span class="meta">${String(item._index + 1).padStart(2, '0')}</span></div><h2>${escapeHtml(item.title)}</h2><p>${escapeHtml(item.location || '凌巽的旅途')}</p></div>
                </article>
            `).join('');
            empty?.classList.toggle('hidden', state.visible.length > 0);
            if (count) count.textContent = String(state.visible.length);
            grid.querySelectorAll('img').forEach((image) => image.addEventListener('error', () => image.closest('.gallery-card')?.classList.add('is-error')));
        }

        function updateFilter(filter: string) {
            state.filter = filter;
            document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
                const active = button.dataset.filter === filter;
                button.classList.toggle('is-active', active);
                button.setAttribute('aria-pressed', String(active));
            });
            renderGrid();
        }

        function renderCharacterFilters(characters: CharacterProfile[]) {
            const target = document.getElementById('gallery-character-filters');
            if (!target || !characters.length) return;
            target.classList.remove('hidden');
            target.innerHTML = `<span class="gallery-character-label">角色</span><button type="button" class="gallery-filter gallery-character-filter is-active" data-character-filter="all" aria-pressed="true">全部角色</button>${characters.map((item) => `<button type="button" class="gallery-filter gallery-character-filter" data-character-filter="${item.id}" aria-pressed="false">${escapeHtml(item.name)}</button>`).join('')}`;
            target.querySelectorAll<HTMLButtonElement>('[data-character-filter]').forEach((button) => button.addEventListener('click', () => {
                const value = button.dataset.characterFilter || 'all';
                if (value === 'all') state.characterFilter = [];
                else {
                    const id = Number(value);
                    state.characterFilter = state.characterFilter.includes(id) ? state.characterFilter.filter((item) => item !== id) : [...state.characterFilter, id];
                }
                target.querySelectorAll<HTMLButtonElement>('[data-character-filter]').forEach((item) => {
                    const active = item.dataset.characterFilter === 'all' ? state.characterFilter.length === 0 : state.characterFilter.includes(Number(item.dataset.characterFilter));
                    item.classList.toggle('is-active', active);
                    item.setAttribute('aria-pressed', String(active));
                });
                renderGrid();
            }));
        }

        function currentVisiblePosition() {
            return Math.max(0, state.visible.findIndex((item) => (item as GalleryItem & { _index?: number })._index === state.current));
        }

        function openLightbox(index: number, trigger: HTMLElement | null = null) {
            state.current = index;
            state.lastTrigger = trigger;
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('modal-open');
            zoomButton?.classList.remove('is-active');
            zoomButton?.setAttribute('aria-pressed', 'false');
            modalImg.classList.remove('is-zoomed');
            updateModal();
            closeButton?.focus();
        }

        function updateModal() {
            const item = state.items[state.current];
            if (!item) return;
            modalImg.classList.remove('is-zoomed');
            zoomButton?.classList.remove('is-active');
            zoomButton?.setAttribute('aria-pressed', 'false');
            modalImg.classList.remove('is-loaded', 'is-error');
            modalStatus?.classList.remove('is-hidden');
            if (modalStatus) modalStatus.textContent = siteText('gallery.image_loading', '正在加载照片……');
            modalImg.src = item.src;
            modalImg.alt = item.title;
            if (modalTitle) modalTitle.textContent = item.title;
            if (modalCategory) modalCategory.textContent = item.category;
            if (modalDescription) modalDescription.textContent = item.description;
            if (modalDate) modalDate.textContent = item.date || '-';
            if (modalLocation) modalLocation.textContent = item.location || '-';
            if (modalPosition) modalPosition.textContent = `${String(currentVisiblePosition() + 1).padStart(2, '0')} / ${String(state.visible.length).padStart(2, '0')}`;
            renderThumbs();
            preloadAround();
        }

        function renderThumbs() {
            if (!modalThumbs) return;
            modalThumbs.innerHTML = state.visible.map((item) => {
                const originalIndex = (item as GalleryItem & { _index?: number })._index ?? state.items.indexOf(item);
                return `<button type="button" class="lightbox-modal__thumb ${originalIndex === state.current ? 'is-active' : ''}" data-thumb-index="${originalIndex}" aria-label="${escapeHtml(siteFormat('gallery.thumb_label', '查看{title}', { title: item.title }))}"><img src="${escapeHtml(item.src)}" alt="" loading="lazy" /></button>`;
            }).join('');
        }

        function preloadAround() {
            const position = currentVisiblePosition();
            [state.visible[(position + 1) % state.visible.length], state.visible[(position - 1 + state.visible.length) % state.visible.length]].forEach((item) => {
                if (item?.src) { const image = new Image(); image.src = item.src; }
            });
        }

        function moveLightbox(direction: number) {
            if (!state.visible.length) return;
            const position = currentVisiblePosition();
            const next = (position + direction + state.visible.length) % state.visible.length;
            state.current = (state.visible[next] as GalleryItem & { _index?: number })._index ?? state.items.indexOf(state.visible[next]);
            modalImg.classList.remove('is-zoomed');
            zoomButton?.setAttribute('aria-pressed', 'false');
            updateModal();
        }

        function closeLightbox() {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('modal-open');
            modalImg.removeAttribute('src');
            state.lastTrigger?.focus();
        }

        document.querySelector('.gallery-filter-list')?.addEventListener('click', (event) => {
            const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
            if (button) updateFilter(button.dataset.filter || '全部');
        });
        grid.addEventListener('click', (event) => {
            const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-gallery-trigger]');
            if (trigger) openLightbox(Number(trigger.dataset.index), trigger);
        });
        modalThumbs?.addEventListener('click', (event) => {
            const thumb = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-thumb-index]');
            if (thumb) { state.current = Number(thumb.dataset.thumbIndex); updateModal(); }
        });
        closeButton?.addEventListener('click', closeLightbox);
        modal.querySelector('[data-modal-close]')?.addEventListener('click', closeLightbox);
        previousButton?.addEventListener('click', () => moveLightbox(-1));
        nextButton?.addEventListener('click', () => moveLightbox(1));
        zoomButton?.addEventListener('click', () => {
            const active = modalImg.classList.toggle('is-zoomed');
            zoomButton.setAttribute('aria-pressed', String(active));
            zoomButton.classList.toggle('is-active', active);
        });
        modalImg.addEventListener('load', () => { modalImg.classList.add('is-loaded'); modalStatus?.classList.add('is-hidden'); });
        modalImg.addEventListener('error', () => { modalImg.classList.add('is-error'); if (modalStatus) modalStatus.textContent = siteText('gallery.image_error', '照片暂时无法打开，请稍后再试。'); });
        document.addEventListener('keydown', (event) => {
            if (!modal.classList.contains('is-open')) return;
            if (event.key === 'Tab') {
                const controls = Array.from(modal.querySelectorAll<HTMLElement>('button:not(:disabled), a[href]')).filter(control => control.getClientRects().length);
                const first = controls[0], last = controls[controls.length - 1];
                if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
                else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
            }
            if (event.key === 'Escape') closeLightbox();
            if (event.key === 'ArrowLeft') moveLightbox(-1);
            if (event.key === 'ArrowRight') moveLightbox(1);
        });
        let touchStartX = 0;
        let touchStartY = 0;
        modalImg.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0].clientX; touchStartY = event.changedTouches[0].clientY; }, { passive: true });
        modalImg.addEventListener('touchend', (event) => {
            const delta = touchStartX - event.changedTouches[0].clientX;
            const vertical = touchStartY - event.changedTouches[0].clientY;
            if (!modalImg.classList.contains('is-zoomed') && Math.abs(delta) > 48 && Math.abs(delta) > Math.abs(vertical) * 1.5) moveLightbox(delta > 0 ? 1 : -1);
        }, { passive: true });
        downloadButton?.addEventListener('click', async () => {
            const item = state.items[state.current];
            if (!item) return;
            const original = downloadButton.innerHTML;
            (downloadButton as HTMLButtonElement).disabled = true;
            downloadButton.textContent = siteText('gallery.saving', '准备保存……');
            try {
                const response = await fetch(item.src);
                if (!response.ok) throw new Error('download failed');
                const blob = await response.blob();
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `${item.title || 'lingxun-photo'}.webp`;
                link.click();
                URL.revokeObjectURL(link.href);
            } catch { if (modalStatus) { modalStatus.textContent = siteText('gallery.save_error', '保存失败，请直接长按图片保存。'); modalStatus.classList.remove('is-hidden'); } }
            downloadButton.innerHTML = original;
            (downloadButton as HTMLButtonElement).disabled = false;
        });

        await loadSiteContent();
        const backendPhotos = await fetchPublic<GalleryPhoto[]>('/api/public/gallery');
        if (backendPhotos) {
            // An empty successful response is authoritative; only failed requests use local fallback.
            state.items = backendPhotos.map((photo) => ({ src: toApiUrl(photo.file_url), title: photo.title || photo.original_filename || siteText('gallery.default_title', '旅途留影'), category: photo.category || siteText('gallery.uncategorized', '未分类'), date: photo.date || '', location: photo.location || '', description: photo.description || '', character_ids: photo.character_ids || [] }));
            const categories = ['全部', ...new Set(state.items.map(item => item.category).filter(category => category !== '全部'))];
            const filters = document.querySelector('.gallery-filter-list');
            if (filters) filters.innerHTML = categories.map(category => `<button type="button" class="gallery-filter ${category === '全部' ? 'is-active' : ''}" data-filter="${escapeHtml(category)}" aria-pressed="${category === '全部'}">${escapeHtml(category)}</button>`).join('');
        }
        renderGrid();
        renderCharacterFilters(await fetchPublic<CharacterProfile[]>('/api/public/characters') || []);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initGalleryPage, { once: true });
    else initGalleryPage();
</script>

<style is:global>
    .gallery-page { min-height: 100vh; padding-block: 8.5rem 3rem; background: var(--ink); color: var(--paper); }
    .gallery-page__header .eyebrow { color: var(--red); }
    .gallery-page__heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: 1rem; }
    .gallery-page .section-title { color: var(--paper); }
    .gallery-page .section-title em { color: var(--steel); }
    .gallery-page .section-copy { color: var(--paper-muted); }
    .gallery-page__index { display: flex; align-items: baseline; gap: 0.5rem; white-space: nowrap; }
    .gallery-page__index strong { color: var(--red); font-family: var(--font-display); font-size: 3.5rem; font-weight: 600; line-height: 1; }
    .gallery-page__filters { margin-top: 2.5rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .gallery-filter-list { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; padding-block: 0.65rem; }
    .gallery-character-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding: 0.65rem 0; border-top: 1px solid var(--line-soft); }
    .gallery-character-label { color: var(--steel-soft); font-size: 0.78rem; }
    .gallery-filter { min-height: 44px; padding: 0.4rem 0; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--steel-soft); cursor: pointer; transition: color 180ms ease, border-color 180ms ease; }
    .gallery-filter:hover, .gallery-filter.is-active { border-color: var(--red); color: var(--red); }
    .gallery-page__content { margin-top: 2rem; }
    .gallery-grid { column-count: 1; column-gap: 1rem; }
    .gallery-card { display: inline-block; width: 100%; margin: 0 0 1rem; overflow: hidden; break-inside: avoid; background: var(--surface-paper); color: var(--paper); }
    .gallery-card:hover { background: var(--surface-paper-hover); }
    .gallery-card__button { position: relative; display: block; width: 100%; padding: 0; border: 0; background: var(--ink-blue); cursor: zoom-in; }
    .gallery-card__button img { display: block; width: 100%; height: auto; filter: saturate(0.7) contrast(1.04); transition: filter 220ms ease, transform 500ms ease; }
    .gallery-card__button:hover img { filter: saturate(1) contrast(1.05); transform: scale(1.025); }
    .gallery-card__open { position: absolute; right: 0.75rem; bottom: 0.75rem; padding: 0.35rem 0.5rem; background: rgba(11, 13, 16, 0.78); color: var(--paper); font-size: 0.74rem; opacity: 0; transform: translateY(0.3rem); transition: opacity 180ms ease, transform 180ms ease; }
    .gallery-card__button:hover .gallery-card__open, .gallery-card__button:focus-visible .gallery-card__open { opacity: 1; transform: translateY(0); }
    .gallery-card__details { padding: 0.8rem; }
    .gallery-card__line { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
    .gallery-page .tag { border-color: rgba(155, 39, 49, 0.5); color: var(--red); }
    .gallery-card h2 { margin: 0.7rem 0 0.15rem; font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.35; }
    .gallery-card p { margin: 0; color: var(--steel-soft); font-size: 0.82rem; }
    .gallery-card.is-error { opacity: 0.65; }
    .gallery-state { padding: 3rem 1rem; border: 1px dashed var(--line); color: var(--steel-soft); text-align: center; }
    .gallery-page__footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; }
    .gallery-page .button--accent { border-color: var(--red); color: var(--red); }
    .gallery-page .button--accent:hover { background: rgba(155, 39, 49, 0.08); }

    .lightbox-modal { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 1rem; visibility: hidden; opacity: 0; transition: opacity 220ms ease, visibility 220ms ease; }
    .lightbox-modal.is-open { visibility: visible; opacity: 1; }
    .lightbox-modal__backdrop { position: absolute; inset: 0; background: rgba(5, 7, 9, 0.92); }
    .lightbox-modal__panel { position: relative; display: grid; width: min(1100px, 100%); max-height: calc(100svh - 2rem); overflow: auto; background: var(--ink-soft); color: var(--paper); box-shadow: 0 25px 90px rgba(0, 0, 0, 0.5); }
    .lightbox-modal__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.8rem 1rem; border-bottom: 1px solid var(--line-soft); }
    .lightbox-modal__toolbar > div:first-child { display: flex; align-items: baseline; gap: 1rem; }
    .lightbox-modal__position { color: var(--paper-muted); font-family: var(--font-mono); font-size: 0.75rem; }
    .lightbox-modal__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .lightbox-modal__actions .button { min-height: 40px; padding: 0.5rem 0.7rem; font-size: 0.8rem; }
    .lightbox-modal__actions .button.is-active { border-color: var(--red); color: var(--red-soft); }
