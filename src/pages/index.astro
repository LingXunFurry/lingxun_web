---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Character from '../components/Character.astro';
import StorySection from '../components/StorySection.astro';
import GallerySection from '../components/GallerySection.astro';
import FeedSection from '../components/FeedSection.astro';
import FinalSection from '../components/FinalSection.astro';
import EasterEgg from '../components/EasterEgg.astro';
---

<Layout title="凌巽的酒馆" titleKey="site.home_title">
    <main id="fullpage-container" class="home-page">
        <Hero />
        <Character />
        <StorySection />
        <GallerySection />
        <FeedSection />
        <FinalSection />
        <EasterEgg />
    </main>
</Layout>

<script>
    const initHomeStageScroll = () => {
        const home = document.querySelector<HTMLElement>('.home-page');
        if (!home) return;

        const desktop = window.matchMedia('(min-width: 900px) and (pointer: fine)');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const eggSection = document.getElementById('easter-egg-section');
        let locked = false;
        let unlockTimer = 0;
        let lastWheelAt = 0;
        let transitionEndsAt = 0;

        const releaseWhenQuiet = () => {
            const remaining = Math.max(transitionEndsAt - performance.now(), lastWheelAt + 220 - performance.now());
            if (remaining > 0) { unlockTimer = window.setTimeout(releaseWhenQuiet, remaining); return; }
            locked = false;
        };

        const getStages = () => Array.from(home.children).filter((element): element is HTMLElement =>
            element instanceof HTMLElement
            && element.tagName === 'SECTION'
            && !element.classList.contains('egg-section')
            && !element.classList.contains('hidden'),
        );

        const isEggOpen = () => Boolean(eggSection && !eggSection.classList.contains('hidden'));

        const currentStage = (stages: HTMLElement[]) => {
            const scrollY = window.scrollY;
            return stages.reduce((closest, stage, index) => {
                const top = stage.getBoundingClientRect().top + scrollY - 76;
                const closestTop = stages[closest].getBoundingClientRect().top + scrollY - 76;
                return Math.abs(top - scrollY) < Math.abs(closestTop - scrollY) ? index : closest;
            }, 0);
        };

        const onWheel = (event: WheelEvent) => {
            if (!desktop.matches || isEggOpen() || event.ctrlKey) return;
            const origin = event.target instanceof Element ? event.target : null;
            if (!origin || !home.contains(origin)) return;
            if (origin.closest('dialog, [role="dialog"], input, textarea, select')) return;

            // Read overflowing content before leaving its scene.
            if (!locked) {
                let node = origin instanceof HTMLElement ? origin : origin.parentElement;
                while (node && node !== home) {
                    const style = getComputedStyle(node);
                    const scrollable = /auto|scroll/.test(style.overflowY) && node.scrollHeight > node.clientHeight + 1;
                    if (scrollable) {
                        const canScroll = event.deltaY > 0
                            ? node.scrollTop + node.clientHeight < node.scrollHeight - 1
                            : node.scrollTop > 1;
                        if (canScroll) return;
                    }
                    node = node.parentElement;
                }
            }

            event.preventDefault();
            lastWheelAt = performance.now();
            if (locked || Math.abs(event.deltaY) < 2) return;

            const stages = getStages();
            if (stages.length < 2) return;

            const nextIndex = Math.min(
                stages.length - 1,
                Math.max(0, currentStage(stages) + (event.deltaY > 0 ? 1 : -1)),
            );
            const target = stages[nextIndex];
            if (!target || target === stages[currentStage(stages)]) return;

            locked = true;
            transitionEndsAt = performance.now() + (reducedMotion.matches ? 80 : 900);
            window.clearTimeout(unlockTimer);
            target.scrollIntoView({
                behavior: reducedMotion.matches ? 'auto' : 'smooth',
                block: 'start',
            });
            unlockTimer = window.setTimeout(releaseWhenQuiet, reducedMotion.matches ? 80 : 900);
        };

        const syncMode = () => {
            const eggOpen = isEggOpen();
            home.classList.toggle('is-egg-open', eggOpen);
            // The wheel guard frees the room; keep earlier scene geometry stable while it is open.
            home.classList.toggle('is-stage-controlled', desktop.matches);
        };

        if (eggSection) {
            new MutationObserver(syncMode).observe(eggSection, {
                attributes: true,
                attributeFilter: ['class'],
            });
        }
        desktop.addEventListener('change', syncMode);
        syncMode();
        window.addEventListener('wheel', onWheel, { passive: false });
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHomeStageScroll, { once: true });
    } else {
        initHomeStageScroll();
    }
</script>
