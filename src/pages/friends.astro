---
import Layout from '../layouts/Layout.astro';
import SceneOrnament from '../components/SceneOrnament.astro';

const friendsData = [
    { id: '寒曜', avatar: 'https://lingxun.me/logo.png', url: 'https://hanyao.me/', comment: '站主的对象，一只银白色的小狼（头像暂时用本龙的代替）' },
    { id: 'lolpzili', avatar: 'https://www.lolpzili.com/img/avatar.webp', url: 'https://furry.lolpzili.com/', comment: '一个年（都不一定）更的博主x' },
    { id: 'LinFun_', avatar: 'https://images-r2.lin-fun.com/92dcd0d286189a611cf38ebe85e9df94.png', url: 'https://blog.lin-fun.com', comment: '遇见更好的Fun' },
    { id: 'Redflag', avatar: null, url: null, comment: '是一只来自北方的狼，和网站主人是舍友（由于还没有个人网站所以头像是空的）' },
    { id: '滚木', avatar: null, url: null, comment: '滚木滚木滚木（实际上是占位名片，也算一个小彩蛋）' },
];
---

<Layout title="同行者名册 | 凌巽的酒馆" titleKey="site.friends_title">
    <main class="friends-page" aria-labelledby="friends-title">
        <SceneOrnament kind="guest" />
        <header class="site-container friends-page__header" data-reveal>
            <div class="eyebrow">同行者名册 / Fellow Travellers</div>
            <h1 id="friends-title" class="section-title">酒馆里的<em>常客</em></h1>
            <p class="section-copy">旅途中遇见的人，会在这本名册里留下一行介绍。可以点开名片，去他们的地方坐坐。</p>
        </header>

        <section class="site-container friends-page__list" aria-live="polite">
            <div id="friends-list" class="friends-grid" data-public-pending aria-busy="true" data-reveal style="--reveal-delay: 120ms">
                {friendsData.map((friend, index) => (
                    <a href={friend.url || undefined} target={friend.url ? '_blank' : undefined} rel={friend.url ? 'noopener noreferrer' : undefined} class={`friend-card paper-card ${index % 3 === 1 ? 'friend-card--offset' : ''}`}>
                        <div class="friend-card__head">
                            <div class="friend-card__avatar">
                                {friend.avatar ? <img src={friend.avatar} alt={friend.id} loading="lazy" decoding="async" /> : <span>{friend.id.slice(0, 1)}</span>}
                            </div>
                            <div class="friend-card__identity"><h2>{friend.id}</h2><span class="meta">同行记录 / {String(index + 1).padStart(2, '0')}</span></div>
                            <span class="friend-card__arrow" aria-hidden="true">↗</span>
                        </div>
                        <div class="friend-card__note"><span class="meta">名册批注</span><p>{friend.comment}</p></div>
                    </a>
                ))}
            </div>
            <div id="friends-empty" class="friends-state hidden">暂时没有公开的同行者名片。</div>
        </section>

        <footer class="site-container friends-page__footer" data-reveal style="--reveal-delay: 220ms">
            <span class="meta">FELLOW TRAVELLERS / 旅途中相遇</span>
            <a href="/" class="button button--quiet"><span aria-hidden="true">←</span> 返回首页</a>
        </footer>
    </main>
</Layout>

<script>
    import { escapeHtml, fetchRequired as fetchPublic, initPublicContent, type FriendLink } from '../lib/publicContent';
    import { loadSiteContent, siteText } from '../lib/siteContent';

    const initFriendsPage = async () => {
        const list = document.getElementById('friends-list');
        const empty = document.getElementById('friends-empty');
        if (!list) return;
        const replaceFailedAvatar = (image: HTMLImageElement) => {
            if (!image.closest('.friend-card__avatar')) return;
            const initial = document.createElement('span');
            initial.textContent = Array.from(image.alt)[0] || '?';
            initial.setAttribute('aria-label', image.alt);
            image.replaceWith(initial);
        };
        list.addEventListener('error', event => {
            if (event.target instanceof HTMLImageElement) replaceFailedAvatar(event.target);
        }, true);
        list.querySelectorAll<HTMLImageElement>('.friend-card__avatar img').forEach(image => {
            if (image.complete && image.currentSrc && !image.naturalWidth) replaceFailedAvatar(image);
        });
        const friends = await fetchPublic<FriendLink[]>('/api/public/friends');
        if (!friends) return;
        if (!friends.length) {
            list.replaceChildren();
            empty?.classList.remove('hidden');
            return;
        }
        await loadSiteContent();
        list.innerHTML = friends.map(renderFriendCard).join('');
    };
    initPublicContent('#friends-list', initFriendsPage);

    function renderFriendCard(friend: FriendLink, index: number) {
        const linkAttributes = friend.url ? `href="${escapeHtml(friend.url)}" target="_blank" rel="noopener noreferrer"` : '';
        const avatar = friend.avatar_url
            ? `<img src="${escapeHtml(friend.avatar_url)}" alt="${escapeHtml(friend.display_id)}" loading="lazy" decoding="async" />`
            : `<span>${escapeHtml(friend.display_id.slice(0, 1) || '?')}</span>`;
        return `
            <a ${linkAttributes} class="friend-card paper-card ${index % 3 === 1 ? 'friend-card--offset' : ''}">
                <div class="friend-card__head">
                    <div class="friend-card__avatar">${avatar}</div>
                    <div class="friend-card__identity"><h2>${escapeHtml(friend.display_id)}</h2><span class="meta">${escapeHtml(siteText('friends.record', '同行记录'))} / ${String(index + 1).padStart(2, '0')}</span></div>
                    <span class="friend-card__arrow" aria-hidden="true">↗</span>
                </div>
                <div class="friend-card__note"><span class="meta">名册批注</span><p>${escapeHtml(friend.comment)}</p></div>
            </a>
        `;
    }
</script>

<style is:global>
    .friends-page { min-height: 100vh; padding-block: 9rem 3rem; background: var(--ink); color: var(--paper); -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
    .friends-page__header .eyebrow { color: var(--red); }
    .friends-page__header .section-title { margin-top: 1rem; color: var(--paper); }
    .friends-page__header .section-title em { color: var(--steel); }
    .friends-page__header .section-copy { color: var(--paper-muted); }
    .friends-page__list { margin-top: 3rem; }
    .friends-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: start; min-width: 0; width: 100%; max-width: 100%; }
    .friend-card { display: block; min-width: 0; width: 100%; max-width: 100%; padding: 1.25rem; color: var(--paper); background: var(--surface-paper); overflow-wrap: break-word; overflow-wrap: anywhere; }
    .friend-card--offset { margin-top: 2rem; }
    .friend-card__head { display: flex; align-items: center; gap: 0.85rem; min-width: 0; }
    .friend-card__avatar { display: grid; flex: 0 0 3.4rem; place-items: center; width: 3.4rem; height: 3.4rem; overflow: hidden; border: 1px solid rgba(11, 13, 16, 0.25); background: var(--ink-blue); color: var(--gold); font-family: var(--font-serif); font-size: 1.45rem; }
    .friend-card__avatar img { width: 100%; height: 100%; object-fit: cover; }
    .friend-card__identity { min-width: 0; max-width: 100%; flex: 1; }
    .friend-card__identity h2 { margin: 0; overflow: hidden; color: var(--paper); font-family: var(--font-serif); font-size: 1.35rem; text-overflow: ellipsis; white-space: nowrap; }
    .friend-card .meta { color: var(--steel-soft); }
    .friend-card__arrow { flex: 0 0 auto; color: var(--red); font-size: 1.2rem; transition: transform 180ms ease, color 180ms ease; }
    .friend-card:hover .friend-card__arrow { color: var(--gold); transform: translate(2px, -2px); }
    .friend-card__note { min-width: 0; max-width: 100%; margin-top: 1.25rem; padding-top: 0.85rem; border-top: 1px solid var(--line); }
    .friend-card__note p { max-width: 100%; margin: 0.45rem 0 0; color: var(--paper-muted); font-size: 0.92rem; line-height: 1.75; white-space: normal; overflow-wrap: break-word; overflow-wrap: anywhere; }
    .friends-state { padding: 2rem; border: 1px dashed var(--line); color: var(--steel-soft); text-align: center; }
    .friends-page__footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; }
    .friends-page .button--quiet { color: var(--paper-muted); }

    @media (max-width: 980px) { .friends-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .friend-card--offset { margin-top: 0; } }
    @media (max-width: 620px) {
        .friends-page { padding-top: 7.5rem; }
        .friends-grid { grid-template-columns: minmax(0, 1fr); }
        .friend-card__identity h2 { white-space: normal; overflow-wrap: break-word; overflow-wrap: anywhere; line-height: 1.35; }
        .friends-page__footer { align-items: flex-start; flex-direction: column; }
    }
</style>
